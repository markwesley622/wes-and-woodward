---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import D from '../../data/site/dashboard.json';
import skaters from '../../data/site/skaters.json';

const S = D.standings, X = D.deserved, P = D.projected, NG = D.nextGame;
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const signed = (v, d = 1) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const pct3 = (v) => `.${String(Math.round(v * 1000)).padStart(3, '0')}`;
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const season = `${D.seasonLabel.slice(0, 4)}–${D.seasonLabel.slice(5)}`;
const rebuilt = new Date(D.generatedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Detroit' }).toLowerCase();

// progress toward MoneyPuck's projection
const live = P.available && P.points;
let prog = null;
if (live) {
  const proj = P.points, pace = S.gamesPlayed ? S.points / S.gamesPlayed * 82 : 0, delta = pace - proj;
  const scale = Math.max(proj, pace) * 1.06;
  const pre = P.preseasonPoints ?? proj;
  const scale2 = Math.max(proj, pace, pre) * 1.06;
  prog = { proj, pre, pace, delta, fill: S.points / scale2 * 100, paceW: Math.max(0, pace - S.points) / scale2 * 100, tick: proj / scale2 * 100, preTick: pre / scale2 * 100,
    verdict: delta >= 0.5 ? 'outperforming the projection' : delta <= -0.5 ? 'underperforming the projection' : 'tracking the projection' };
}
const projWhen = NG ? `before the opener ${mdy(NG.date)}` : 'once the season opens';

// ranked tiles
const KEEP = { xg_share_5v5: ['5v5 xG share', 'moneypuck, five-on-five'], finishing: ['Finishing', 'G minus xG, all situations'],
  pp_xgf60: ['PP xG per 60', '5v4, xG generated'], pk_xga60: ['PK xGA per 60', '4v5, lower is better'] };
const tiles = D.tiles.filter((t) => KEEP[t.key]).map((t) => ({
  label: KEEP[t.key][0], note: KEEP[t.key][1], rank: t.rank, rankLabel: t.rankLabel,
  value: t.signed ? signed(t.value, 1) : t.unit === '%' ? `${t.value.toFixed(1)}%` : (Math.abs(t.value) < 20 ? t.value.toFixed(2) : t.value.toFixed(1)),
}));
const tile = (key) => tiles[D.tiles.filter((t) => KEEP[t.key]).findIndex((t) => t.key === key)];
const T5 = tile('xg_share_5v5'), TPP = tile('pp_xgf60'), TPK = tile('pk_xga60');

// top three, ordered by game score until the value score ships
const POS = { C: 'Center', L: 'Left wing', R: 'Right wing', D: 'Defense' };
const top3 = skaters.filter((p) => p.gameScore != null).sort((a, b) => b.gameScore - a.gameScore).slice(0, 3);
const dots = (n) => Array.from({ length: Math.max(0, n) });
---
<Base title="Wes & Woodward — Detroit hockey, by the numbers" description="Independent Detroit Red Wings analytics: record, expected-goals standings, and the numbers behind a paywall elsewhere.">
  <section class="hero" aria-label="Detroit hockey, by the numbers">
    <div class="shell">
      <div class="stamp mono"><i></i><span id="clock">&nbsp;</span><br />Detroit, MI</div>
      <h1><span class="l1">Detroit</span><span class="l2">Red Wings,</span><span class="l3">by the numbers</span></h1>
      <Wheel />
      <div class="foot mono"><span></span><span>nhl api · moneypuck · rebuilt {rebuilt} et</span></div>
    </div>
  </section>

  <section class="sec" id="analysis">
    <div class="shell">
      <h2>Analysis</h2>
      <div class="row3">
        {[['Featured', '2026–2027 Detroit Red Wings predictions'], ['Latest', 'Do the Red Wings have a type?'], ['Latest', 'Is Michael Rasmussen really as bad as fans think he is?']].map(([kind, title]) => (
          <a class:list={['card', 'article', { pin: kind === 'Featured' }]} href="#">
            <span class:list={['eb', 'mono', { red: kind === 'Featured' }]}>{kind}</span>
            <div class="thumb" aria-hidden="true"></div>
            <h3>{title}</h3>
            <span class="mono" style="margin-top:auto">Read &rarr;</span>
          </a>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all articles &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="dashboard">
    <div class="shell">
      <h2>Team dashboard</h2>
      <div class="grid">
        <div class="tile">
          <span class="eb mono">Record · {season}</span>
          <span class="num big red">{S.points} <span class="of">pts</span></span>
          <span class="sub"><span class="tip" title="Wins, losses, overtime losses">{S.wins}–{S.losses}–{S.otLosses}</span> · <span class="tip" title="Points percentage: points earned of points available">{pct3(S.pointPctg)}</span> · <span class="tip" title="Goals for, goals against, and the goal differential">{S.goalFor}–{S.goalAgainst} ({signed(S.goalDifferential, 0)})</span></span>
        </div>
        <div class="tile"><span class="eb mono tip" title="Share of expected goals at five-on-five: the chances Detroit creates against the chances it allows, per MoneyPuck">{T5.label}</span><span class="num">{T5.value}</span><span class:list={['sub', { red: T5.rank <= 10 }]}>{T5.rankLabel}</span></div>
        <div class="tile"><span class="eb mono tip" title="Place in the division on the NHL's own standings">{S.division.name} Division</span><span class="num">{ordinal(S.division.place)}</span><span class="sub">of {S.division.teams} · actual</span></div>
        <div class="tile"><span class="eb mono tip" title="Place in the conference on the NHL's own standings">{S.conference.name} Conference</span><span class="num">{ordinal(S.conference.place)}</span><span class="sub">of {S.conference.teams} · actual</span></div>

        <div class="tile"><span class="eb mono tip" title="Expected goals generated per 60 minutes on the power play (5v4)">{TPP.label}</span><span class="num">{TPP.value}</span><span class:list={['sub', { red: TPP.rank <= 10 }]}>{TPP.rankLabel}</span></div>
        <div class="tile"><span class="eb mono tip" title="Expected goals allowed per 60 minutes on the penalty kill (4v5); lower is better">{TPK.label}</span><span class="num">{TPK.value}</span><span class:list={['sub', { red: TPK.rank <= 10 }]}>{TPK.rankLabel}</span></div>

        <div class="tile"><span class="eb mono tip" title="Where the same games place Detroit when every team is scored on expected goals instead of actual goals">{S.division.name} Division</span><span class="num">{ordinal(X.divisionPlace)}</span><span class="sub">of {S.division.teams} · expected results</span></div>
        <div class="tile"><span class="eb mono tip" title="Where the same games place Detroit when every team is scored on expected goals instead of actual goals">{S.conference.name} Conference</span><span class="num">{ordinal(X.conferencePlace)}</span><span class="sub">of {S.conference.teams} · expected results</span></div>
        <div class="tile full progress">
          <span class="eb mono tip" title="Points banked against MoneyPuck's season simulation. The pre-season projection is frozen on opening night; the updated projection is re-run after every result.">Progress toward MoneyPuck&rsquo;s projected points</span>
          {prog ? (
            <>
              <span class="num"><span class="red">{S.points}</span> <span class="of">of {prog.proj.toFixed(0)} · pacing to {prog.pace.toFixed(0)}</span></span>
              <div class="track">
                <div class="fill" style={`width:${prog.fill.toFixed(2)}%`}></div>
                <div class="fill faint" style={`left:${prog.fill.toFixed(2)}%;width:${prog.paceW.toFixed(2)}%`}></div>
                <div class="tickmark pre" style={`left:${prog.preTick.toFixed(2)}%`} title={`Pre-season projection: ${prog.pre.toFixed(0)}`}></div>
                <div class="tickmark" style={`left:${prog.tick.toFixed(2)}%`} title={`Updated projection: ${prog.proj.toFixed(0)}`}></div>
              </div>
              <span class="sub"><span class="tip" title="MoneyPuck's projection as of opening night, frozen for the season">pre-season projection {prog.pre.toFixed(0)}</span> · <span class="tip" title="MoneyPuck's projection re-run after every result">updated projection {prog.proj.toFixed(0)}</span> · <span class="red">{signed(prog.delta, 1)}</span> · {prog.verdict}</span>
            </>
          ) : (
            <>
              <span class="num mute">&mdash;</span>
              <div class="track"></div>
              <span class="sub"><span class="tip" title="MoneyPuck's projection as of opening night, frozen for the season">pre-season projection: &mdash;</span> · <span class="tip" title="MoneyPuck's projection re-run after every result">updated projection: TBD</span> · publishes {projWhen}</span>
            </>
          )}
        </div>
      </div>
      <div class="viewall mono"><a href="/team/">View all team stats &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="players">
    <div class="shell">
      <h2>Top Red Wings</h2>
      <div class="row3">
        {top3.map((p) => (
          <a class="card player" href={p.playerId === 8481542 ? '/players/moritz-seider/' : '#'}>
            <div class="card-top">
              <div><h3>{p.name}</h3><span class="mono mute">{POS[p.position] ?? p.position} · {season}</span></div>
              <div class="score"><span class="ghost" style="width:30px;height:16px"></span><span class="mono red">/ 100</span></div>
            </div>
            <div class="portrait">
              <span class="mono mute">Scored {p.goals}</span>
              <div class="dots">{dots(p.goals).map(() => <i class="d solid"></i>)}</div>
              <span class="mono mute">Expected {Math.round(p.ixG ?? 0)}</span>
              <div class="dots">{dots(Math.round(p.ixG ?? 0)).map(() => <i class="d"></i>)}</div>
            </div>
            <div class="stats">
              {[['GP', p.gamesPlayed], ['G', p.goals], ['A', p.assists], ['P', p.points], ['ixG', p.ixG != null ? p.ixG.toFixed(1) : '—'], ['5v5 xG%', p.fiveOnFive ? Math.round(p.fiveOnFive.onIceXgPct * 100) : '—']].map(([k, v]) => (
                <div><span class="mono mute">{k}</span><span class="n">{v}</span></div>
              ))}
            </div>
            <span class="mono">Full player page &rarr;</span>
          </a>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all players &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="prospects">
    <div class="shell">
      <h2>Top Prospects</h2>
      <div class="plist">
        <div class="prow head mono"><span>Rank</span><span>Player</span><span>Club · league</span><span class="r">Score</span></div>
        {[1, 2, 3, 4, 5].map((i) => (
          <div class="prow">
            <span class:list={['rk', { red: i === 1 }]}>{i}</span>
            <span class="ghost" style={`width:${i % 2 ? 62 : 48}%`}></span>
            <span class="ghost thin" style="width:60%"></span>
            <span class="r"><span class="ghost" style="width:42px;margin-left:auto"></span></span>
          </div>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all prospects &rarr;</a></div>
    </div>
  </section>
</Base>

<script>
  const clock = document.getElementById('clock');
  if (clock) {
    const tick = () => { clock.textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Detroit' }); };
    tick(); setInterval(tick, 30000);
  }
</script>

<style>
  /* hero */
  /* overflow-x clip (not hidden) keeps the wheel free to parallax down past the hero's bottom edge while clipping its sides */
  .hero { position: relative; height: calc(100vh - 94px); min-height: 640px; border-bottom: 1px solid var(--rule); overflow-x: clip; }
  .hero .shell { position: relative; height: 100%; }
  .stamp { position: absolute; left: var(--gutter); top: 22px; color: var(--mute); z-index: 3; }
  .stamp i { display: block; width: 5px; height: 5px; background: var(--red); margin-bottom: 8px; }
  h1 { position: absolute; left: var(--gutter); right: var(--gutter); top: 96px; z-index: 3; pointer-events: none; }
  h1 span { display: block; }
  h1 .l2 { padding-left: .12em; }
  h1 .l3 { padding-left: 1.05em; }
  h1 .red { display: inline; }
  .foot { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 18px; display: flex; justify-content: space-between; gap: 16px; color: var(--mute); z-index: 3; }

  /* dashboard extras */
  /* dashboard grid: 4 columns; Atlantic and Eastern actual sit over their expected-results tiles on the right */
  .tile.full { grid-column: 1 / -1; }
  .tile .num .of { font-size: 18px; font-weight: 500; color: var(--mute); letter-spacing: 0; }
  .tip { border-bottom: 1px dotted var(--mute); cursor: help; }
  .tile .eb.tip, .card .eb.tip { display: inline-block; align-self: flex-start; width: auto; }
  .track .tickmark.pre { background: var(--mute); }
  .card.article .thumb { aspect-ratio: 16 / 9; background: var(--ghost); border-radius: 3px; }
  .card.article h3 { font-size: 20px; line-height: 1.2; }
  .progress .num { font-size: 44px; }
  .progress .num .of { font-size: 16px; font-weight: 500; color: var(--mute); letter-spacing: 0; }

  /* player cards */
  .card.player { gap: 14px; }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .score { display: flex; align-items: baseline; gap: 6px; }
  .portrait { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; align-items: center; }
  .dots { display: flex; flex-wrap: wrap; gap: 3px; }
  .d { width: 7px; height: 7px; border: 1px solid var(--ink); border-radius: 50%; }
  .d.solid { background: var(--ink); }
  .stats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; border-top: 1px solid var(--rule); padding-top: 10px; }
  .stats div { display: flex; flex-direction: column; gap: 2px; }
  .stats .n { font-family: var(--mono); font-size: 15px; font-variant-numeric: tabular-nums; }

  /* phone layout only below 640px; a narrow desktop window keeps the desktop hero so resizing never snaps */
  @media (max-width: 640px) {
    .hero { height: 100svh; }
    h1 { font-size: clamp(40px, 14.5vw, 64px); }
    h1 .l3 { padding-left: .5em; }
    .foot { flex-direction: column; gap: 4px; background: var(--paper); padding: 8px 0 0; }
  }
</style>
