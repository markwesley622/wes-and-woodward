---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import D from '../../data/site/dashboard.json';
import skaters from '../../data/site/skaters.json';

const S = D.standings, X = D.deserved, P = D.projected, NG = D.nextGame;
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const signed = (v, d = 1) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const pct3 = (v) => `.${String(Math.round(v * 1000)).padStart(3, '0')}`;
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const season = `${D.seasonLabel.slice(0, 4)}–${D.seasonLabel.slice(5)}`;
const rebuilt = new Date(D.generatedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Detroit' }).toLowerCase();

// progress toward MoneyPuck's projection
const live = P.available && P.points;
let prog = null;
if (live) {
  const proj = P.points, pace = S.gamesPlayed ? S.points / S.gamesPlayed * 82 : 0, delta = pace - proj;
  const scale = Math.max(proj, pace) * 1.06;
  prog = { proj, pace, delta, fill: S.points / scale * 100, paceW: Math.max(0, pace - S.points) / scale * 100, tick: proj / scale * 100,
    verdict: delta >= 0.5 ? 'outperforming the projection' : delta <= -0.5 ? 'underperforming the projection' : 'tracking the projection' };
}
const projWhen = NG ? `before the opener ${mdy(NG.date)}` : 'once the season opens';

// ranked tiles
const KEEP = { xg_share_5v5: ['5v5 xG share', 'moneypuck, five-on-five'], finishing: ['Finishing', 'G minus xG, all situations'],
  pp_xgf60: ['PP xG per 60', '5v4, xG generated'], pk_xga60: ['PK xGA per 60', '4v5, lower is better'] };
const tiles = D.tiles.filter((t) => KEEP[t.key]).map((t) => ({
  label: KEEP[t.key][0], note: KEEP[t.key][1], rank: t.rank, rankLabel: t.rankLabel,
  value: t.signed ? signed(t.value, 1) : t.unit === '%' ? `${t.value.toFixed(1)}%` : (Math.abs(t.value) < 20 ? t.value.toFixed(2) : t.value.toFixed(1)),
}));

// top three, ordered by game score until the value score ships
const POS = { C: 'Centre', L: 'Left wing', R: 'Right wing', D: 'Defence' };
const top3 = skaters.filter((p) => p.gameScore != null).sort((a, b) => b.gameScore - a.gameScore).slice(0, 3);
const dots = (n) => Array.from({ length: Math.max(0, n) });
---
<Base title="Wes & Woodward — Detroit hockey, by the numbers" description="Independent Detroit Red Wings analytics: record, expected-goals standings, and the numbers behind a paywall elsewhere.">
  <section class="hero" aria-label="Detroit hockey, by the numbers">
    <div class="shell">
      <div class="stamp mono"><i></i><span id="clock">&nbsp;</span><br />Detroit, MI</div>
      <h1><span class="l1">Detroit</span><span class="l2">hockey,</span><span class="l3">by the numbers<span class="red">*</span></span></h1>
      <Wheel />
      <div class="foot mono"><span>*expected goals, not vibes</span><span>nhl api · moneypuck · rebuilt {rebuilt} et</span></div>
    </div>
  </section>

  <section class="sec" id="dashboard">
    <div class="shell">
      <h2>Team dashboard</h2>
      <div class="grid">
        <div class="tile wide">
          <span class="eb mono">Record · {season}</span>
          <span class="num big">{S.wins}–{S.losses}–{S.otLosses}</span>
          <span class="sub"><span class="red">{S.points} pts</span> · {pct3(S.pointPctg)} · {S.goalFor}–{S.goalAgainst} ({signed(S.goalDifferential, 0)}) · {S.gamesPlayed} gp · last ten {S.lastTen ?? '—'}</span>
        </div>
        <div class="tile"><span class="eb mono">{S.division.name} Division</span><span class="num">{ordinal(S.division.place)}</span><span class="sub">of {S.division.teams} · {ordinal(X.divisionPlace)} by expected goals</span></div>
        <div class="tile"><span class="eb mono">{S.conference.name} Conference</span><span class="num">{ordinal(S.conference.place)}</span><span class="sub">of {S.conference.teams} · {ordinal(X.conferencePlace)} by expected goals</span></div>

        <div class="tile wide progress">
          <span class="eb mono">Progress toward MoneyPuck's projected points</span>
          {prog ? (
            <>
              <span class="num"><span class="red">{S.points}</span> <span class="of">of {prog.proj.toFixed(0)}</span></span>
              <div class="track">
                <div class="fill" style={`width:${prog.fill.toFixed(2)}%`}></div>
                <div class="fill faint" style={`left:${prog.fill.toFixed(2)}%;width:${prog.paceW.toFixed(2)}%`}></div>
                <div class="tickmark" style={`left:${prog.tick.toFixed(2)}%`}></div>
              </div>
              <span class="sub">pacing to {prog.pace.toFixed(0)} pts · <span class="red">{signed(prog.delta, 1)}</span> · {prog.verdict}</span>
            </>
          ) : (
            <>
              <span class="num mute">—</span>
              <div class="track"></div>
              <span class="sub">moneypuck publishes its projection {projWhen} · pace and verdict render from game one</span>
            </>
          )}
        </div>
        <div class="tile"><span class="eb mono">xG win share</span><span class="num">{(X.xgWinPct * 100).toFixed(1)}%</span><span class="sub">actual {(S.wins / Math.max(1, S.gamesPlayed) * 100).toFixed(1)}% · xG-pythagorean</span></div>
        <div class="tile"><span class="eb mono">xG points</span><span class="num">{X.xgPoints.toFixed(1)}</span><span class="sub">actual {S.points} · {signed(X.pointsAboveExpected)}</span></div>

        <div class="tile"><span class="eb mono">xG place, NHL</span><span class="num">{ordinal(X.leaguePlace)}</span><span class="sub">actual {ordinal(S.league.place)} of 32</span></div>
        <div class="tile"><span class="eb mono">Regulation wins</span><span class="num">{S.regulationWins}</span><span class="sub">{S.gamesPlayed} gp · streak {S.streak ?? '—'}</span></div>
        {tiles.map((t, i) => (
          <div class:list={['tile', { wide: i >= 2 }]}>
            <span class="eb mono">{t.label}</span>
            <span class="num">{t.value}</span>
            <span class:list={['sub', { red: t.rank <= 10 }]}>{t.rankLabel} · {t.note}</span>
          </div>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all team stats &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="analysis">
    <div class="shell">
      <h2>Analysis</h2>
      <div class="row3">
        {['Pinned', 'Latest', 'Latest'].map((kind) => (
          <a class:list={['card', { pin: kind === 'Pinned' }]} href="#">
            <span class:list={['eb', 'mono', { red: kind === 'Pinned' }]}>{kind}</span>
            <div><div class="ghost" style="width:92%;height:19px;margin-bottom:8px"></div><div class="ghost" style="width:70%;height:19px"></div></div>
            <div class="ghost thin" style="width:100%"></div>
            <span class="mono" style="margin-top:auto">Read &rarr;</span>
          </a>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all analysis &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="players">
    <div class="shell">
      <h2>Top Red Wings</h2>
      <div class="row3">
        {top3.map((p) => (
          <a class="card player" href="#">
            <div class="card-top">
              <div><h3>{p.name}</h3><span class="mono mute">{POS[p.position] ?? p.position} · {season}</span></div>
              <div class="score"><span class="ghost" style="width:30px;height:16px"></span><span class="mono red">/ 100</span></div>
            </div>
            <div class="portrait">
              <span class="mono mute">Scored {p.goals}</span>
              <div class="dots">{dots(p.goals).map(() => <i class="d solid"></i>)}</div>
              <span class="mono mute">Expected {Math.round(p.ixG ?? 0)}</span>
              <div class="dots">{dots(Math.round(p.ixG ?? 0)).map(() => <i class="d"></i>)}</div>
            </div>
            <div class="stats">
              {[['GP', p.gamesPlayed], ['G', p.goals], ['A', p.assists], ['P', p.points], ['ixG', p.ixG != null ? p.ixG.toFixed(1) : '—'], ['5v5 xG%', p.fiveOnFive ? Math.round(p.fiveOnFive.onIceXgPct * 100) : '—']].map(([k, v]) => (
                <div><span class="mono mute">{k}</span><span class="n">{v}</span></div>
              ))}
            </div>
            <span class="mono">Full player page &rarr;</span>
          </a>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all players &rarr;</a></div>
    </div>
  </section>

  <section class="sec" id="prospects">
    <div class="shell">
      <h2>Top Prospects</h2>
      <div class="plist">
        <div class="prow head mono"><span>Rank</span><span>Player</span><span>Club · league</span><span class="r">Score</span></div>
        {[1, 2, 3, 4, 5].map((i) => (
          <div class="prow">
            <span class:list={['rk', { red: i === 1 }]}>{i}</span>
            <span class="ghost" style={`width:${i % 2 ? 62 : 48}%`}></span>
            <span class="ghost thin" style="width:60%"></span>
            <span class="r"><span class="ghost" style="width:42px;margin-left:auto"></span></span>
          </div>
        ))}
      </div>
      <div class="viewall mono"><a href="#">View all prospects &rarr;</a></div>
    </div>
  </section>
</Base>

<script>
  const clock = document.getElementById('clock');
  if (clock) {
    const tick = () => { clock.textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Detroit' }); };
    tick(); setInterval(tick, 30000);
  }
</script>

<style>
  /* hero */
  .hero { position: relative; height: calc(100vh - 94px); min-height: 640px; border-bottom: 1px solid var(--rule); }
  .hero .shell { position: relative; height: 100%; }
  .stamp { position: absolute; left: var(--gutter); top: 22px; color: var(--mute); z-index: 3; }
  .stamp i { display: block; width: 5px; height: 5px; background: var(--red); margin-bottom: 8px; }
  h1 { position: absolute; left: var(--gutter); top: 96px; z-index: 3; pointer-events: none; }
  h1 span { display: block; }
  h1 .l2 { padding-left: .12em; }
  h1 .l3 { padding-left: 1.05em; }
  h1 .red { display: inline; }
  .foot { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 18px; display: flex; justify-content: space-between; gap: 16px; color: var(--mute); z-index: 3; }

  /* dashboard extras */
  .progress .num { font-size: 44px; }
  .progress .num .of { font-size: 16px; font-weight: 500; color: var(--mute); letter-spacing: 0; }

  /* player cards */
  .card.player { gap: 14px; }
  .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .score { display: flex; align-items: baseline; gap: 6px; }
  .portrait { display: grid; grid-template-columns: auto 1fr; gap: 6px 12px; align-items: center; }
  .dots { display: flex; flex-wrap: wrap; gap: 3px; }
  .d { width: 7px; height: 7px; border: 1px solid var(--ink); border-radius: 50%; }
  .d.solid { background: var(--ink); }
  .stats { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; border-top: 1px solid var(--rule); padding-top: 10px; }
  .stats div { display: flex; flex-direction: column; gap: 2px; }
  .stats .n { font-family: var(--mono); font-size: 15px; font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .hero { height: 100vh; }
    .foot { flex-direction: column; gap: 4px; background: var(--paper); padding: 8px 0 0; }
  }
</style>
