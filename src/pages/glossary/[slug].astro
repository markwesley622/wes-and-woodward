---
// One glossary page per stat. Every page renders the same fixed slots in the same order (research/glossary-pseo/TEMPLATE.md);
// only the fills in src/data/glossary/<slug>.json change. Headings are built here from stat.short, never from the JSON.
import Base from '../../layouts/Base.astro';
import { glossary, glossarySlugs, resolveLive, plain } from '../../lib/glossary.js';

export function getStaticPaths() {
  return glossary.map((g) => ({ params: { slug: g.slug }, props: { G: g } }));
}

const { G } = Astro.props;
const S = G.stat, short = S.short;
const SITE = 'https://wesandwoodward.com';
const URL = `${SITE}/glossary/${G.slug}/`;
const live = resolveLive(G.live);
const related = G.related.map((r) => ({ ...r, href: glossarySlugs.has(r.slug) ? `/glossary/${r.slug}/` : null }));
const variants = (G.calculation.variants ?? []).map((v) => ({ ...v, href: v.slug && glossarySlugs.has(v.slug) ? `/glossary/${v.slug}/` : null }));
const faq = G.faq ?? [];

// fixed slot list: [id, heading]. The abbreviation keeps its case inside the uppercase H2.
// Mixed-case abbreviations (xG, GSAx, QoC, iCF) keep their case inside the uppercase H2; plain words and
// all-caps abbreviations just uppercase. stat.plural switches the verbs ("Where hits come from").
const keepCase = /[a-z].*[A-Z]|[A-Z]{2,}[a-z]/.test(short);
const ab = keepCase ? `<span class="ab">${short}</span>` : short;
const pl = !!S.plural, [comes, is, tells] = pl ? ['come', 'are', 'tell'] : ['comes', 'is', 'tells'];
const H = {
  origin: ['origin', `Where ${ab} ${comes} from`],
  calc: ['calculation', `How ${ab} ${is} calculated`],
  meaning: ['meaning', `What ${ab} ${tells} you`],
  uses: ['uses', `How analysts use ${ab}`],
  live: ['red-wings', `${ab} on the Red Wings`],
  limits: ['limits', `What ${ab} can't tell you`],
  related: ['related', 'Related stats'],
  faq: ['questions', 'Questions'],
  sources: ['sources', 'Sources'],
};
const toc = [H.origin, H.calc, H.meaning, H.uses, ...(live ? [H.live] : []), H.limits, H.related, ...(faq.length ? [H.faq] : []), H.sources];

const schema = [
  { '@type': 'WebPage', '@id': URL, url: URL, name: G.seo.title, description: G.seo.description, isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': `${URL}#term` }, dateModified: G.reviewed, inLanguage: 'en-US' },
  { '@type': 'DefinedTerm', '@id': `${URL}#term`, name: S.name, alternateName: S.aliases, ...(S.abbr ? { termCode: S.abbr } : {}), description: plain(G.hero.definition), url: URL, inDefinedTermSet: { '@id': `${SITE}/glossary/#set` } },
  { '@type': 'DefinedTermSet', '@id': `${SITE}/glossary/#set`, name: 'Wes & Woodward hockey stats glossary', url: `${SITE}/glossary/` },
  ...(faq.length ? [{ '@type': 'FAQPage', '@id': `${URL}#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) }] : []),
];
---
<Base title={`${G.seo.title} | Wes & Woodward`} description={G.seo.description} schema={schema} crumb={S.name}>
  <!-- 1. Hero: H1 + one-sentence definition (the answer passage) + dek + quick facts -->
  <section class="sec hero">
    <div class="shell">
      <p class="kicker"><a href="/glossary/">Glossary</a> · {S.category} stat</p>
      <h1 class="page-title">{G.seo.h1}</h1>
      <p class="def" set:html={G.hero.definition} />
      <p class="dek" set:html={G.hero.dek} />
      <div class="grid facts">
        {G.facts.map((f) => (
          <div class="tile"><span class="eb mono">{f.label}</span><span class="num">{f.value}</span><span class="sub">{f.sub}</span></div>
        ))}
      </div>
      <nav class="toc mono" aria-label="On this page">
        {toc.map(([id, h]) => <a href={`#${id}`} set:html={h} />)}
      </nav>
    </div>
  </section>

  <!-- 2. Where it comes from -->
  <section class="sec" id={H.origin[0]}>
    <div class="shell">
      <h2 set:html={H.origin[1]} />
      <div class="prose">{G.origin.map((p) => <p set:html={p} />)}</div>
    </div>
  </section>

  <!-- 3. How it's calculated: inputs, formulas, worked example, variants -->
  <section class="sec" id={H.calc[0]}>
    <div class="shell">
      <h2 set:html={H.calc[1]} />
      <div class="prose">
        {G.calculation.intro.map((p) => <p set:html={p} />)}
        {G.calculation.inputs && <ul class="inputs">{G.calculation.inputs.map((i) => <li set:html={i} />)}</ul>}
      </div>
      <div class="formulas">
        {G.calculation.formulas.map((f) => (
          <div class="frow"><span class="mono flabel">{f.label}</span><code>{f.expr}</code></div>
        ))}
      </div>
      <div class="prose">
        <p class="example" set:html={G.calculation.example} />
        {(G.calculation.after ?? []).map((p) => <p set:html={p} />)}
      </div>
      {variants.length > 0 && (
        <dl class="variants">
          {variants.map((v) => (
            <div class="vrow">
              <dt class="mono lc">{v.href ? <a href={v.href}>{v.term}</a> : v.term}</dt>
              <dd set:html={v.def} />
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  <!-- 4. What it tells you -->
  <section class="sec" id={H.meaning[0]}>
    <div class="shell">
      <h2 set:html={H.meaning[1]} />
      <div class="prose">{G.meaning.map((p) => <p set:html={p} />)}</div>
    </div>
  </section>

  <!-- 5. How analysts use it -->
  <section class="sec" id={H.uses[0]}>
    <div class="shell">
      <h2 set:html={H.uses[1]} />
      <div class="prose">
        {G.uses.map((u) => (<><h3 class="sub3">{u.title}</h3><p set:html={u.html} /></>))}
      </div>
    </div>
  </section>

  <!-- 6. Live: Red Wings numbers from the nightly pipeline -->
  {live && (
    <section class="sec" id={H.live[0]}>
      <div class="shell">
        <h2 set:html={H.live[1]} />
        <p class="lede">{live.intro}</p>
        {live.note && <p class="note mono lc">{live.note}</p>}
        {live.tiles.length > 0 && <div class="grid live-grid" style={`--cols:${Math.min(4, live.tiles.length)};--cols-sm:${Math.min(2, live.tiles.length)}`}>
          {live.tiles.map((t) => (
            <div class="tile"><span class="eb mono tip" title={t.note}>{t.label}</span><span class="num">{t.value}</span><span class:list={['sub', { red: t.top }]}>{t.sub}</span></div>
          ))}
        </div>}
        {live.leaders && (
          <div class="table-scroll">
            <table>
              <caption class="mono lc">{live.leaders.caption}, {live.season}</caption>
              <thead><tr><th>Player</th>{live.leaders.columns.map((c) => <th class="r">{c}</th>)}</tr></thead>
              <tbody>
                {live.leaders.rows.map((r) => (
                  <tr><td>{r.href ? <a href={r.href}>{r.name}</a> : r.name}</td>{r.cells.map((c) => <td class="r">{c}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="note mono lc">Data: {live.credit}, rebuilt {live.asOf}.</p>
      </div>
    </section>
  )}

  <!-- 7. What it can't tell you -->
  <section class="sec" id={H.limits[0]}>
    <div class="shell">
      <h2 set:html={H.limits[1]} />
      <div class="prose">
        {G.limits.map((l) => (<><h3 class="sub3">{l.title}</h3><p set:html={l.html} /></>))}
      </div>
    </div>
  </section>

  <!-- 8. Related stats -->
  <section class="sec" id={H.related[0]}>
    <div class="shell">
      <h2 set:html={H.related[1]} />
      <div class="row3 rel">
        {related.map((r) => (
          r.href
            ? <a class="card" href={r.href}><span class="eb mono lc">{r.abbr}</span><h3>{r.name}</h3><p>{r.vs}</p></a>
            : <div class="card soon"><span class="eb mono lc">{r.abbr}</span><h3>{r.name}</h3><p>{r.vs}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Questions (only when the answers add something the body doesn't) -->
  {faq.length > 0 && (
    <section class="sec" id={H.faq[0]}>
      <div class="shell">
        <h2 set:html={H.faq[1]} />
        <div class="prose">
          {faq.map((f) => (<><h3 class="sub3">{f.q}</h3><p set:html={f.a} /></>))}
        </div>
      </div>
    </section>
  )}

  <!-- 10. Sources + method -->
  <section class="sec" id={H.sources[0]}>
    <div class="shell">
      <h2 set:html={H.sources[1]} />
      <ol class="sources">
        {G.sources.map((s) => (
          <li><a href={s.url}>{s.label}</a>, {s.publisher}<span class="mute">. {s.note}</span></li>
        ))}
      </ol>
      <p class="note mono lc">{G.method}</p>
      <p class="note mono lc">Last reviewed {new Date(G.reviewed + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}.</p>
    </div>
  </section>
</Base>

<style>
  .kicker a { color: inherit; }
  .kicker a:hover { color: var(--ink); }
  .page-title { font-size: clamp(40px, 6vw, 84px); line-height: .92; margin-bottom: 26px; max-width: 16ch; text-wrap: balance; }
  .def { max-width: 62ch; font-size: clamp(20px, 2vw, 25px); line-height: 1.4; font-weight: 500; letter-spacing: -.01em; margin: 0 0 18px; }
  .dek { max-width: 68ch; font-size: 18px; line-height: 1.6; color: var(--mute); margin: 0 0 34px; }
  .facts .tile { min-height: 128px; }
  .facts .num { font-size: 34px; }
  .toc { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 26px; }
  .toc a { border-bottom: 1px solid var(--rule); padding-bottom: 2px; }
  .toc :global(.ab), .sec h2 :global(.ab) { text-transform: none; }
  .prose { max-width: 68ch; font-size: 18px; line-height: 1.65; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(a) { color: var(--red); }
  .sub3 { font-size: 22px; margin: 30px 0 10px; }
  .sub3:first-child { margin-top: 0; }
  .inputs { margin: 0 0 22px; padding-left: 20px; }
  .inputs li { margin: 0 0 6px; }
  .formulas { max-width: 68ch; border-top: 1px solid var(--ink); margin: 6px 0 26px; }
  .frow { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .flabel { color: var(--mute); }
  .frow code { font-family: var(--mono); font-size: 15px; }
  .example { border-left: 3px solid var(--red); padding-left: 18px; }
  .variants { max-width: 68ch; margin: 8px 0 0; border-top: 1px solid var(--rule); }
  .vrow { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .vrow dt { font-size: 14px; font-weight: 500; }
  .vrow dt a { color: var(--red); }
  .vrow dd { margin: 0; font-size: 16px; line-height: 1.55; }
  .lede { max-width: 68ch; font-size: 18px; line-height: 1.6; margin: 0 0 18px; }
  .note { color: var(--mute); font-size: 11px; margin: 14px 0 0; max-width: 72ch; line-height: 1.6; }
  table caption { text-align: left; color: var(--mute); padding: 26px 0 10px; font-size: 11px; }
  th.r, td.r { text-align: right; padding-right: 0; padding-left: 14px; }
  td a { color: var(--ink); border-bottom: 1px solid var(--rule); }
  td a:hover { color: var(--red); }
  .rel .card { min-height: 170px; }
  .rel .card p { margin: 0; color: var(--mute); font-size: 15px; line-height: 1.5; }
  .rel a.card:hover { border-color: var(--red); color: inherit; }
  .rel a.card:hover h3 { color: var(--red); }
  .rel .soon { opacity: .55; }
  .sources { max-width: 80ch; margin: 0; padding-left: 22px; font-size: 15px; line-height: 1.55; }
  .sources li { margin: 0 0 8px; }
  .sources a { color: var(--red); }
  @media (max-width: 560px) {
    .frow, .vrow { grid-template-columns: 1fr; gap: 4px; }
  }
  .live-grid { grid-template-columns: repeat(var(--cols), 1fr); }
  @media (max-width: 900px) { .live-grid { grid-template-columns: repeat(var(--cols-sm), 1fr); } }
</style>
