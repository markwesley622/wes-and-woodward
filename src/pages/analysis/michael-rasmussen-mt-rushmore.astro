---
import Base from '../../layouts/Base.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import { article, newsArticle } from '../../lib/articles.js';
import C from '../../../data/site/articles/michael-rasmussen-mt-rushmore-copy.json';
import c2 from '../../../data/site/articles/michael-rasmussen-mt-rushmore/c2-trusted-group.svg?raw';
import c3 from '../../../data/site/articles/michael-rasmussen-mt-rushmore/c3-onice-goals.svg?raw';
import c4 from '../../../data/site/articles/michael-rasmussen-mt-rushmore/c4-fates.svg?raw';

const SLUG = 'michael-rasmussen-mt-rushmore';
const parts = C.parts, idx = C.idx;
// each figure goes right after the paragraph its anchor names (anchors come from research/rasmussen-rushmore/build_copy.py)
const figs = [[idx.fig_fates, c4], [idx.fig_trusted, c2], [idx.fig_onice, c3]];
const blocks = [];
let start = 0;
for (const [after, svg] of figs) {
  blocks.push({ html: parts.slice(start, after + 1).join('') });
  blocks.push({ svg });
  start = after + 1;
}
blocks.push({ html: parts.slice(start).join('') });

const DESC = article(SLUG).description;
---
<Base ogType="article" ogImage={`/og/${SLUG}.png`} ogImageAlt="Mt. Rushmore in line art" schema={[newsArticle(SLUG, { description: DESC,
  about: [{ '@id': 'https://wesandwoodward.com/team/#team' }, { '@type': 'Person', name: 'Michael Rasmussen' }],
  keywords: ['Michael Rasmussen', 'Detroit Red Wings', 'pointless streak', 'Luke Glendening', 'Per Svartvadet', 'Trevor Lewis', 'time on ice'], wordCount: C.words })]}
  title={`${C.title} — Wes & Woodward`} description={DESC}>
  <section class="sec">
    <div class="shell">
      <ArticleHead slug={SLUG} title={C.title} />
      {blocks.map((b) => b.html !== undefined
        ? <div class="prose" set:html={b.html} />
        : <figure class="fig" set:html={b.svg} />)}
      <p class="note mono" style="margin-top:28px">Method: a streak is every consecutive regular-season game a forward dressed for without a point, counted in minutes, and it may cross seasons and teams. The 47 streaks are every forward streak of 400 or more minutes since 1997-98, the first season the NHL recorded time on ice; game logs are the NHL API's. Goals for and against with the player on the ice are MoneyPuck's all-situations game files, which start in 2008-09. AHL games come from each player's season totals, so a demotion is matched to a season, not a date. Hits are the NHL's real-time stats. Rasmussen's streak ran from Jan. 8 to Oct. 13, 2026, with nine games missed to injury inside it. Stat line credit: Prashanth Iyer.</p>
    </div>
  </section>
</Base>

<style>
  .prose { max-width: 68ch; font-size: 18px; line-height: 1.65; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(h3.art) { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.1; letter-spacing: -.02em; text-transform: none; margin: 40px 0 16px; }
  .prose :global(h3.art::before) { content: "// "; color: var(--red); }
  .fig { margin: 26px 0 38px; max-width: 760px; }
  .fig :global(svg) { width: 100%; height: auto; display: block; }
  .note { color: var(--mute); font-size: 11px; margin: 10px 0 0; text-transform: none; letter-spacing: 0; max-width: 68ch; }
</style>
