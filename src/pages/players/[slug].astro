---
import Base from '../../layouts/Base.astro';
import PlayerPage from '../../components/PlayerPage.astro';
import fs from 'node:fs';
import path from 'node:path';

import { hasNhlPage, hasProspectPage, nhlPageIsCanonical } from '../../lib/pages.js';
import { seasonMenu } from '../../lib/seasons.js';

export async function getStaticPaths() {
  const dir = path.resolve('data/site/players');
  const files = fs.readdirSync(dir).filter((f) => f.endsWith('.json'));
  return files.map((f) => JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'))).filter(hasNhlPage).map((P) => {
    const art = fs.existsSync(path.resolve(`public/players/${P.playerId}-art.webp`));
    const pf = path.resolve(`data/site/prospects/${P.playerId}.json`);
    const prospect = fs.existsSync(pf) ? JSON.parse(fs.readFileSync(pf, 'utf8')) : null;   // the prospect-system block (build_prospects.py)
    return { params: { slug: P.slug }, props: { P, art, prospect } };
  });
}
const { P, art, prospect } = Astro.props;

const B = P.bio;
const isG = P.bio.position === 'G', isP = false;
const prospectPage = hasProspectPage(P) ? `/prospects/${P.slug}/` : null;
const canonical = prospectPage && !nhlPageIsCanonical(P) ? prospectPage : undefined;
const season = `${P.seasonLabel.slice(0, 4)}–${P.seasonLabel.slice(5)}`;
---
<Base ogType="profile" canonical={canonical} ogImage={art ? `/og/players/${P.slug}.jpg` : `/og/players/${P.slug}.png`} ogImageAlt={art ? `${P.name}, illustrated` : `${P.name}’s initials in block letters`} schema={[{ '@type': 'ProfilePage', '@id': `https://wesandwoodward.com/players/${P.slug}/`, url: `https://wesandwoodward.com/players/${P.slug}/`, name: P.name, isPartOf: { '@id': 'https://wesandwoodward.com/#website' }, dateModified: P.updatedAt,
  mainEntity: { '@type': 'Person', '@id': `https://wesandwoodward.com/players/${P.slug}/#person`, name: P.name, jobTitle: isG ? 'Professional hockey goaltender' : 'Professional hockey player', birthDate: B.birthDate, birthPlace: B.birthplace ? { '@type': 'Place', name: B.birthplace } : undefined,
    height: B.heightIn ? { '@type': 'QuantitativeValue', value: B.heightIn, unitCode: 'INH' } : undefined, weight: B.weightLb ? { '@type': 'QuantitativeValue', value: B.weightLb, unitCode: 'LBR' } : undefined,
    memberOf: { '@id': 'https://wesandwoodward.com/team/#team' }, image: P.art ? `https://wesandwoodward.com/players/${P.playerId}-art.webp` : undefined, sameAs: [`https://www.nhl.com/player/${P.playerId}`] } }]} title={`${P.name} Advanced Stats and Analytics | Wes & Woodward`} crumb={P.name} description={isP ? `${P.name}, Red Wings prospect: draft pedigree and every line he played in ${season}.` : `${P.name}, ${season}: W-Value, where it comes from, and a game-by-game log with game score.`}>
  <PlayerPage P={P} art={art} prospect={prospect} seasons={seasonMenu(P)} />
</Base>
