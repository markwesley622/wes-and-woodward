---
import Base from '../../layouts/Base.astro';
import P from '../../../data/site/players/8481542.json';

const B = P.bio, L = P.seasonLine, SC = P.score, MP = P.moneypuck, G = P.gameLog, GS = P.gameScore, HS = P.hsc, TG = P.teamGameScore;
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const last = (n) => n.split(' ').slice(-1)[0];
const gameLink = (r) => r.gameId ? `#g-${r.gameId}` : '#gamelog';
const gameText = (r) => r.opponent ? `${mdy(r.date)} ${r.home ? 'vs' : 'at'} ${r.opponent}` : r.date;
const season = `${P.seasonLabel.slice(0, 4)}–${P.seasonLabel.slice(5)}`;
const signed = (v, d = 1) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const age = Math.floor((Date.now() - new Date(B.birthDate)) / (365.25 * 24 * 3600 * 1000));
const ht = B.heightIn ? `${Math.floor(B.heightIn / 12)}′${B.heightIn % 12}″` : '';
const POS = { C: 'Center', L: 'Left wing', R: 'Right wing', D: 'Defense' };
const f5 = MP.fiveOnFive || {};
const tier = SC.value >= 88 ? 'elite' : SC.value >= 73 ? 'top-line' : SC.value >= 50 ? 'above average' : SC.value >= 27 ? 'below average' : 'replacement level';

// game score chart
const W = 1000, H = 220, PAD = 8, MID = H / 2;
const maxGS = Math.max(3, ...G.map((g) => Math.abs(g.gameScore ?? 0)));
const bx = (i) => PAD + (i + 0.5) * ((W - 2 * PAD) / Math.max(1, G.length));
const bh = (v) => Math.abs(v) / maxGS * (MID - PAD);
const roll = G.map((g, i) => { const win = G.slice(Math.max(0, i - 9), i + 1).map((x) => x.gameScore).filter((v) => v != null); return win.length ? win.reduce((a, b) => a + b, 0) / win.length : 0; });
const rollPath = roll.map((v, i) => `${i === 0 ? 'M' : 'L'}${bx(i).toFixed(1)},${(MID - v / maxGS * (MID - PAD)).toFixed(1)}`).join(' ');
const dots = (n) => Array.from({ length: Math.max(0, n) });
// impact map
const IM = P.impact, CA = P.career, CO = P.comps, MY = P.myComponents;
const IW = 1000, IH = 620, IP = { l: 56, r: 24, t: 24, b: 48 };
const offs = IM.map((d) => d.off), defs = IM.map((d) => d.def);
const xMin = Math.min(...offs), xMax = Math.max(...offs), yMin = Math.min(...defs), yMax = Math.max(...defs);
const padX = (xMax - xMin) * 0.06, padY = (yMax - yMin) * 0.06;
const ix = (v) => IP.l + (v - (xMin - padX)) / ((xMax + padX) - (xMin - padX)) * (IW - IP.l - IP.r);
const iy = (v) => IH - IP.b - (v - (yMin - padY)) / ((yMax + padY) - (yMin - padY)) * (IH - IP.t - IP.b);
const topNHL = [...IM].sort((a, b) => (b.off + b.def) - (a.off + a.def)).slice(0, 10).map((d) => d.name);
const detNames = IM.filter((d) => d.det).map((d) => d.name);
const xTicks = [-0.4, -0.2, 0, 0.2, 0.4].filter((v) => v >= xMin - padX && v <= xMax + padX);
const yTicks = [-0.4, -0.2, 0, 0.2, 0.4].filter((v) => v >= yMin - padY && v <= yMax + padY);
// career arc
const COMP = [['EVO', 'EV offense'], ['EVD', 'EV defense'], ['PPO', 'Power play'], ['SHD', 'Penalty kill'], ['Pens', 'Penalties']];
const CW = 1000, CH = 300, CP = { l: 48, r: 16, t: 28, b: 40 };
const posMax = Math.max(4, ...CA.map((c) => Object.values(c.components).filter((v) => v > 0).reduce((a, b) => a + b, 0)));
const negMax = Math.max(1, ...CA.map((c) => -Object.values(c.components).filter((v) => v < 0).reduce((a, b) => a + b, 0)));
const cy = (v) => CP.t + (posMax - v) / (posMax + negMax) * (CH - CP.t - CP.b);
const slot = (CW - CP.l - CP.r) / Math.max(1, CA.length), barW = Math.min(90, slot * 0.56);
const cx = (i) => CP.l + slot * (i + 0.5);
const seasonLabel = (sn) => `20${sn.slice(0, 2)}–${sn.slice(3)}`;
const careerBars = CA.map((c, i) => { let up = 0, down = 0; return COMP.map(([k]) => { const v = c.components[k] ?? 0; let y0, y1; if (v >= 0) { y0 = cy(up + v); y1 = cy(up); up += v; } else { y0 = cy(down); y1 = cy(down + v); down += v; } return { k, v, x: cx(i) - barW / 2, y: y0, h: Math.max(0, y1 - y0) }; }); });
const cTicks = [-5, 0, 5, 10, 15, 20, 25, 30].filter((v) => v >= -negMax && v <= posMax);
const RECENT = 10;
---
<Base title={`${P.name} — Wes & Woodward`} description={`${P.name}, ${season}: value score, where it comes from, and a game-by-game log with game score.`}>
  <section class="sec">
    <div class="shell">
      <p class="kicker"><a href="/">Players</a> · Red Wings · {season}</p>
      <div class="head">
        <picture class="art"><source srcset="/players/8481542-art.webp" type="image/webp" /><img src="/players/8481542-art.png" alt={`${P.name}, illustrated`} width="1100" height="745" /></picture>
        <div class="who">
          <h1 class="page-title">{P.name}</h1>
          <p class="mono bio">#{B.number} · {POS[B.position] ?? B.position} · shoots {B.shoots} · {ht}, {B.weightLb} lb · age {age} · {B.birthplace}{B.draft ? ` · drafted ${B.draft.year}, ${B.draft.overallPick}th overall` : ''}</p>
        </div>
        <div class="scorebox">
          <span class="eb mono">W&amp;W value</span>
          <span class="score">{SC.value.toFixed(1)}</span>
          <span class="mono range">likely {SC.low.toFixed(1)}–{SC.high.toFixed(1)} · {tier}</span>
          <span class="mono split">sustainable {SC.sustainable.toFixed(1)} · results {SC.results.toFixed(1)}</span>
        </div>
      </div>
      <div class="grid">
        <div class="tile"><span class="eb mono">Games</span><span class="num">{L.gp}</span><span class="sub">{season}</span></div>
        <div class="tile"><span class="eb mono">Goals · assists · points</span><span class="num">{L.goals}–{L.assists}–{L.points}</span><span class="sub">{L.ppPoints} on the power play · {signed(L.plusMinus, 0)}</span></div>
        <div class="tile"><span class="eb mono">Individual xG</span><span class="num">{MP.ixG?.toFixed(1) ?? '—'}</span><span class="sub">{MP.goalsAboveExpected != null ? `${signed(MP.goalsAboveExpected)} goals vs expected` : ''}</span></div>
        <div class="tile"><span class="eb mono">5v5 xG share</span><span class="num">{f5.onIceXgPct != null ? `${Math.round(f5.onIceXgPct * 100)}%` : '—'}</span><span class:list={['sub', { red: (f5.pctl_onIceXgPct ?? 0) >= 75 }]}>{f5.qualifiesForPercentiles ? `${f5.pctl_onIceXgPct}th percentile among ${SC.position === 'D' ? 'defensemen' : 'forwards'} · ${Math.round(f5.icetimeMinutes)} min` : ''}</span></div>
      </div>
    </div>
  </section>

  <section class="sec" id="value">
    <div class="shell">
      <h2>Where the value comes from</h2>
      <div class="two">
        <div class="left">
        <div class="table-scroll">
          <table>
            <thead><tr><th>Component</th><th class="num">Sustainable</th><th class="num">Results</th><th class="num">Repeats</th><th class="num">Counted</th></tr></thead>
            <tbody>
              {SC.components.map((c) => (
                <tr><td>{c.label}</td><td class="num">{signed(c.sustainable)}</td><td class="num">{signed(c.results)}</td><td class="num">{Math.round(c.repeat * 100)}%</td><td class:list={['num', { red: c.counted >= 3 }]}>{signed(c.counted)}</td></tr>
              ))}
              <tr class="total"><td>Total, goals above replacement</td><td class="num">{signed(SC.raw.xGAR)}</td><td class="num">{signed(SC.raw.GAR)}</td><td class="num">{Math.round(SC.reliability * 100)}%</td><td class="num red">{signed(SC.goalsBlended)}</td></tr>
            </tbody>
          </table>
          <p class="note mono">Sustainable = Evolving-Hockey xGAR (chances). Results = GAR (goals). Counted = a {Math.round(SC.blend.sustainable * 100)}/{Math.round(SC.blend.results * 100)} blend of the two, leaning toward chances because they repeat better year to year; this season only, nothing regressed. Repeats = that component's year-to-year repeatability, which sets the likely range, not the number.</p>
        </div>
        <div class="rankwrap">
        <p class="eb mono">Where he ranks · all NHL skaters, {SC.pool} with 20+ games</p>
        <table class="rank">
          <thead><tr><th>Rank</th><th>Player</th><th>Team</th><th>Pos</th><th class="num">GP</th><th class="num">Value</th><th class="num">Goals counted</th></tr></thead>
          <tbody>
            {SC.neighbours.map((n) => (
              <tr class:list={{ me: n.isMe }}><td class="rk">{n.rank}</td><td>{n.name}</td><td>{n.team}</td><td>{n.pos}</td><td class="num">{n.gp}</td><td class:list={['num', { red: n.isMe }]}>{n.value.toFixed(1)}</td><td class="num">{n.goals > 0 ? '+' : ''}{n.goals.toFixed(1)}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="note mono">Two above and two below on the same score. Rank {SC.rank} of {SC.pool}.</p>
        </div>

        </div>
        <div class="prose-sm">
          <p><strong>Score {SC.value.toFixed(1)}</strong> is on a 0 to 100 scale where 50 is the average NHL skater with twenty or more games this season, forwards and defensemen on one scale. Around the middle a standard deviation of value is worth about 23 points, and the scale compresses toward the ends, so it reads like QBR rather than a percentile: {P.name.split(' ')[1]} sits {Math.log(SC.value / (100 - SC.value)).toFixed(1)} standard deviations above the average of {SC.pool} skaters, which is the {Math.round(SC.percentile)}th percentile. The likely range, {SC.low.toFixed(1)} to {SC.high.toFixed(1)}, is how much of that is noise given how well each component repeats at his minutes; the number itself is this season's delivered value, not a projection.</p>
          <p>Two outside checks. HockeyStatCards' Luszczyszyn model puts his net rating in the {HS.Net?.percentile}th percentile ({HS.Net?.value}) and his game score in the {HS['Game score']?.percentile}th. Evolving-Hockey's own headline number is {SC.raw.WAR} wins above replacement.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="impact">
    <div class="shell">
      <div class="sec-head">
        <h2>Isolated impact</h2>
        <div class="toggle mono" role="tablist" aria-label="Scope">
          <button type="button" class="on" data-scope="nhl" role="tab" aria-selected="true">NHL</button>
          <button type="button" data-scope="det" role="tab" aria-selected="false">Detroit</button>
        </div>
      </div>
      <p class="lede">Even-strength impact on chances for and chances against, isolated from teammates, opponents and zone starts by Evolving-Hockey's RAPM. Up and right is good at both ends. One dot per skater with twenty games; move across the chart and the nearest name follows.</p>
      <svg class="chart impact" viewBox={`0 0 ${IW} ${IH}`} role="img" aria-label="Isolated even-strength impact, offense against defense, every NHL skater" data-scope="nhl">
        {xTicks.map((v) => <g><line x1={ix(v)} x2={ix(v)} y1={IP.t} y2={IH - IP.b} class:list={['grid', { zero: v === 0 }]} /><text x={ix(v)} y={IH - IP.b + 18} text-anchor="middle" class="lbl">{v > 0 ? '+' : ''}{v.toFixed(1)}</text></g>)}
        {yTicks.map((v) => <g><line x1={IP.l} x2={IW - IP.r} y1={iy(v)} y2={iy(v)} class:list={['grid', { zero: v === 0 }]} /><text x={IP.l - 8} y={iy(v) + 4} text-anchor="end" class="lbl">{v > 0 ? '+' : ''}{v.toFixed(1)}</text></g>)}
        <text x={IW - IP.r} y={IH - 6} text-anchor="end" class="axis-name">offense · expected goals for per 60, impact</text>
        <text x={IP.l - 40} y={IP.t + 4} class="axis-name" transform={`rotate(-90 ${IP.l - 40} ${IP.t + 4})`} text-anchor="end">defense · expected goals against per 60 suppressed</text>
        {IM.filter((d) => !d.me).map((d) => (
          <circle cx={ix(d.off)} cy={iy(d.def)} r="4.5" class:list={['pt', { det: d.det }]} data-det={d.det ? '1' : '0'} data-tip={`${d.name} · ${d.team} · ${d.pos}\noffense ${d.off >= 0 ? '+' : ''}${d.off.toFixed(2)} · defense ${d.def >= 0 ? '+' : ''}${d.def.toFixed(2)} · ${d.toi} EV min`} />
        ))}
        {IM.filter((d) => d.me).map((d) => (
          <circle cx={ix(d.off)} cy={iy(d.def)} r="8" class="pt me" data-tip={`${d.name} · DET · D\noffense ${d.off >= 0 ? '+' : ''}${d.off.toFixed(2)} · defense ${d.def >= 0 ? '+' : ''}${d.def.toFixed(2)} · ${d.toi} EV min`} />
        ))}
        {IM.filter((d) => topNHL.includes(d.name) || d.det).map((d) => (
          <text x={ix(d.off) + (d.me ? 12 : 8)} y={iy(d.def) + 4} class:list={['tag', { nhl: topNHL.includes(d.name), det: d.det, me: d.me }]}>{d.me ? d.name : d.name.split(' ').slice(-1)[0]}</text>
        ))}
      </svg>
      <div class="legend mono"><span><i class="dot me"></i>Seider</span><span class="det-only"><i class="dot det"></i>Red Wings</span><span><i class="dot other"></i>every other skater</span><span class="mute">Evolving-Hockey RAPM, 5v5, {season}</span></div>
    </div>
  </section>

  <section class="sec" id="career">
    <div class="shell">
      <h2>Career arc</h2>
      <p class="lede">Value by season, split into the five components, on the same 60/40 blend of chances and results. Bars above the line add value; below the line cost it.</p>
      <svg class="chart career" viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Value by season, stacked by component">
        {cTicks.map((v) => <g><line x1={CP.l} x2={CW - CP.r} y1={cy(v)} y2={cy(v)} class:list={['grid', { zero: v === 0 }]} /><text x={CP.l - 8} y={cy(v) + 4} text-anchor="end" class="lbl">{v > 0 ? '+' : ''}{v}</text></g>)}
        {careerBars.map((bars, i) => (
          <g>
            {bars.map((b) => b.h > 0.5 && (
              <rect x={b.x} y={b.y} width={barW} height={Math.max(0, b.h - 2)} class={`seg ${b.k}`} data-tip={`${seasonLabel(CA[i].season)} · ${COMP.find(([k]) => k === b.k)[1]} ${b.v >= 0 ? '+' : ''}${b.v.toFixed(1)}\nseason total ${CA[i].total >= 0 ? '+' : ''}${CA[i].total.toFixed(1)}`} />
            ))}
            <text x={cx(i)} y={cy(Math.max(0, Object.values(CA[i].components).filter((v) => v > 0).reduce((a, b) => a + b, 0))) - 8} text-anchor="middle" class="total">{CA[i].total >= 0 ? '+' : ''}{CA[i].total.toFixed(1)}</text>
            <text x={cx(i)} y={CH - CP.b + 18} text-anchor="middle" class="lbl">{seasonLabel(CA[i].season)}</text>
            <text x={cx(i)} y={CH - CP.b + 32} text-anchor="middle" class="lbl mute">{CA[i].gp} gp</text>
          </g>
        ))}
      </svg>
      <div class="legend mono">{COMP.map(([k, label]) => <span><i class={`sw ${k}`}></i>{label}</span>)}</div>
    </div>
  </section>

  <section class="sec" id="comps">
    <div class="shell">
      <h2>Player comps</h2>
      <p class="lede">The three {SC.position === 'D' ? 'defensemen' : 'forwards'} whose value profile this season sits closest to his, component for component. A comp is a shape match, not a value match, so the score is shown beside each.</p>
      <div class="row3">
        {CO.map((c) => (
          <div class="card comp">
            <div class="comp-head"><div><h3>{c.name}</h3><span class="mono mute">{c.team} · {c.pos} · {c.gp} gp</span></div><span class="comp-val">{c.value.toFixed(1)}</span></div>
            <table class="mini">
              <thead><tr><th></th><th class="num">{c.name.split(' ').slice(-1)[0]}</th><th class="num red">Seider</th></tr></thead>
              <tbody>{COMP.map(([k, label]) => <tr><td>{label}</td><td class="num">{signed(c.components[k])}</td><td class="num">{signed(MY[k])}</td></tr>)}<tr class="total"><td>Total</td><td class="num">{signed(c.goals)}</td><td class="num red">{signed(SC.goalsBlended)}</td></tr></tbody>
            </table>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="gamelog">
    <div class="shell">
      <h2>Game log</h2>
      <div class="gs-tiles">
        <div class="tile"><span class="eb mono">Game score, average</span><span class="num">{GS.average.toFixed(2)}</span><span class="sub">{GS.games} games · Luszczyszyn game score via HockeyStatCards</span>
          {TG && <span class="fn mono">{ordinal(TG.avgRank)} of {TG.players} Red Wings with {TG.minGames}+ games</span>}</div>
        <div class="tile"><span class="eb mono">Best game</span><span class="num">{GS.best.value.toFixed(2)}</span><span class="sub">{mdy(GS.best.date)} {G.find((g) => g.date === GS.best.date)?.home ? 'vs' : 'at'} {GS.best.opponent}</span>
          {TG && <span class="fn mono">Team best: {TG.best.name === P.name ? 'his' : last(TG.best.name) + ','} {TG.best.value.toFixed(2)} <a href={gameLink(TG.best)} class="glink">{gameText(TG.best)}</a></span>}</div>
        <div class="tile"><span class="eb mono">Worst game</span><span class="num">{GS.worst.value.toFixed(2)}</span><span class="sub">{mdy(GS.worst.date)} {G.find((g) => g.date === GS.worst.date)?.home ? 'vs' : 'at'} {GS.worst.opponent}</span>
          {TG && <span class="fn mono">Team worst: {TG.worst.name === P.name ? 'his' : last(TG.worst.name) + ','} {TG.worst.value.toFixed(2)} <a href={gameLink(TG.worst)} class="glink">{gameText(TG.worst)}</a></span>}</div>
        <div class="tile"><span class="eb mono">Games at 2.0 or better</span><span class="num">{GS.above2}</span><span class="sub">{GS.below0} below zero</span>
          {TG && <span class="fn mono">{TG.most2.name === P.name ? `Most on the team${TG.next2 ? ` · ${last(TG.next2.name)} next with ${TG.next2.above2}` : ''}` : `Most: ${last(TG.most2.name)}, ${TG.most2.above2} · ${TG.most2.below0} below zero`}</span>}</div>
      </div>
      <p class="eb mono chart-eb">Game score by game · red above zero, black below · line is the ten-game average</p>
      <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Game score in every game this season">
        <line x1={PAD} x2={W - PAD} y1={MID} y2={MID} class="axis" />
        {G.map((g, i) => g.gameScore == null ? null : (
          <g class:list={['bar', { pos: g.gameScore >= 0 }]}>
            <rect x={bx(i) - 3} y={g.gameScore >= 0 ? MID - bh(g.gameScore) : MID} width={6} height={Math.max(1.5, bh(g.gameScore))} data-tip={`${mdy(g.date)} ${g.home ? 'vs' : 'at'} ${g.opponent}\ngame score ${g.gameScore.toFixed(2)} · ${g.goals}G ${g.assists}A · ${g.toi} min`} />
            <rect x={bx(i) - 6} y={PAD} width={12} height={H - 2 * PAD} class="hit" data-tip={`${mdy(g.date)} ${g.home ? 'vs' : 'at'} ${g.opponent}\ngame score ${g.gameScore.toFixed(2)} · ${g.goals}G ${g.assists}A · ${g.toi} min`} />
          </g>
        ))}
        <path d={rollPath} class="roll" />
      </svg>
      <div class="axis-labels mono"><span>{mdy(G[0].date)}</span><span>{mdy(G[G.length - 1].date)}</span></div>

      <div class="table-scroll log" id="log">
        <table>
          <thead><tr><th>Date</th><th>Opp</th><th class="num">TOI</th><th class="num">G</th><th class="num">A</th><th class="num">P</th><th class="num">+/−</th><th class="num">S</th><th class="num">Blk</th><th class="num">ixG</th><th class="num">xGF</th><th class="num">xGA</th><th class="num">GF–GA</th><th class="num">Game score</th></tr></thead>
          <tbody>
            {[...G].reverse().map((g, i) => (
              <tr id={`g-${g.gameId}`} class:list={{ more: i >= RECENT }}>
                <td>{mdy(g.date)}</td><td>{g.home ? 'vs' : 'at'} {g.opponent}</td><td class="num">{g.toi.toFixed(1)}</td>
                <td class="num">{g.goals}</td><td class="num">{g.assists}</td><td class:list={['num', { red: g.points >= 2 }]}>{g.points}</td><td class="num">{signed(g.plusMinus, 0)}</td><td class="num">{g.shots}</td>
                <td class="num">{g.blocks != null ? g.blocks.toFixed(0) : '—'}</td><td class="num">{g.ixg != null ? g.ixg.toFixed(2) : '—'}</td>
                <td class="num">{g.xgf != null ? g.xgf.toFixed(2) : '—'}</td><td class="num">{g.xga != null ? g.xga.toFixed(2) : '—'}</td>
                <td class="num">{g.gf != null ? `${g.gf.toFixed(0)}–${g.ga.toFixed(0)}` : '—'}</td>
                <td class:list={['num', 'gs', { red: (g.gameScore ?? 0) >= 2, neg: (g.gameScore ?? 0) < 0 }]}>{g.gameScore != null ? g.gameScore.toFixed(2) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <button type="button" class="showall mono" id="showall" aria-expanded="false">Show all {G.length} games &darr;</button>
      <p class="note mono">Most recent first. Box score from the NHL API. ixG, on-ice xGF/xGA and GF–GA are five-on-five, per HockeyStatCards (Natural Stat Trick data); TOI is all situations. Game score is Dom Luszczyszyn's formula, where 2.0 is a strong night and below zero is a poor one.</p>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll('.toggle button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.toggle button').forEach((o) => { o.classList.toggle('on', o === b); o.setAttribute('aria-selected', String(o === b)); });
    document.querySelector('.impact').dataset.scope = b.dataset.scope;
  }));
  // hover layer: an HTML tooltip that follows the pointer; the impact map snaps to the nearest dot
  const tip = document.createElement('div'); tip.className = 'tt'; document.body.appendChild(tip);
  const showTip = (text, ex, ey) => { tip.textContent = text; tip.style.display = 'block'; const w = tip.offsetWidth, h = tip.offsetHeight; let l = ex + 14, t = ey + 14; if (l + w > innerWidth - 8) l = ex - w - 14; if (t + h > innerHeight - 8) t = ey - h - 14; tip.style.left = l + 'px'; tip.style.top = t + 'px'; };
  const hideTip = () => { tip.style.display = 'none'; };
  document.querySelectorAll('[data-tip]:not(.impact [data-tip])').forEach((el) => {
    el.addEventListener('mousemove', (e) => showTip(el.dataset.tip, e.clientX, e.clientY));
    el.addEventListener('mouseleave', hideTip);
  });
  const imp = document.querySelector('.impact');
  if (imp) {
    const pts = [...imp.querySelectorAll('circle.pt')]; let hot = null;
    imp.addEventListener('mousemove', (e) => {
      let best = null, bd = 26 * 26;
      for (const c of pts) { const r = c.getBoundingClientRect(); const dx = r.left + r.width / 2 - e.clientX, dy = r.top + r.height / 2 - e.clientY; const d = dx * dx + dy * dy; if (d < bd) { bd = d; best = c; } }
      if (hot && hot !== best) hot.classList.remove('hot');
      if (best) { best.classList.add('hot'); hot = best; showTip(best.dataset.tip, e.clientX, e.clientY); } else { hideTip(); hot = null; }
    });
    imp.addEventListener('mouseleave', () => { if (hot) hot.classList.remove('hot'); hot = null; hideTip(); });
  }
  const openRow = () => { const id = location.hash.slice(1); const row = id && document.getElementById(id); if (row && row.classList.contains('more')) { const lg = document.getElementById('log'), sa = document.getElementById('showall'); if (lg && !lg.classList.contains('open')) { lg.classList.add('open'); if (sa) { sa.setAttribute('aria-expanded', 'true'); sa.textContent = 'Show the last 10 games ↑'; } } row.scrollIntoView({ block: 'center' }); } };
  document.querySelectorAll('a.glink').forEach((a) => a.addEventListener('click', () => setTimeout(openRow, 0)));
  addEventListener('hashchange', openRow); openRow();
  const showall = document.getElementById('showall'), log = document.getElementById('log');
  if (showall) showall.dataset.all = showall.textContent;
  if (showall && log) showall.addEventListener('click', () => { const open = log.classList.toggle('open'); showall.setAttribute('aria-expanded', String(open)); showall.textContent = open ? 'Show the last 10 games ↑' : showall.dataset.all; });
</script>

