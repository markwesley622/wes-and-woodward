---
// Prospect page: a player still eligible for NHL rookie status. No W-Value (the NHL sample is
// too small to rate), so the page is bio, draft pedigree, every line he played last season across
// leagues, and the NHL game log if there is one.
import Initials from '../../components/Initials.astro';
import { pipelineWindow, pipelineSize, rankStartDate } from '../../lib/pipeline.js';
const { P, prospect, twin = null } = Astro.props;   // twin: the player's NHL-level page, when he has one
const B = P.bio, L = P.seasonLine || {}, G = P.gameLog || [], LINES = P.seasonLines || [];
// prospect-system block (build_prospects.py): league strength, age-relative performance, cohort ceiling, trajectory
const R = prospect || null, A = R?.anchor || null, C = R?.ceiling || null, PF = R?.performance?.last || null, PC = R?.performance?.current || null, TR = R?.trajectory || null, PD = R?.pedigree || null, DP = R?.deployment || null;
const pctWord = (v) => (v == null ? '—' : ordinal(Math.round(v)));
const tierClass = (t) => ({ 'elite': 'elite', 'top-line': 'top', 'above average': 'above' }[t] || '');
const sgn = (v, d = 0) => (v == null ? '—' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d));
const isGoalie = R?.group === 'G';
const posWord = R ? (R.group === 'D' ? 'defensemen' : R.group === 'G' ? 'goalies' : 'forwards') : 'skaters';
const seasonLabel = (s) => `${s.slice(0, 4)}–${s.slice(7)}`;
const sv3 = (v) => (v == null ? '—' : Number(v).toFixed(3).replace(/^0/, ''));
// the production feature in display units: skaters NHLe points per 82, goalies thousandths of save percentage above the league average
const featText = (v) => (v == null ? '—' : isGoalie ? sgn(v * 1000, 0) : (v * 82).toFixed(1));
const SEASONS = R?.seasons && R.seasons.length ? R.seasons : null;
// NHL usage (build_prospects.py nhl_usage): rookies who got the same NHL ice time at his age, blended by games
const NU = R?.nhlUsage || null;
const mmss = (sec) => `${Math.floor(sec / 60)}:${String(Math.round(sec % 60)).padStart(2, '0')}`;
const peakParts = [R?.blend?.w > 0 ? `draft slot weighted ${R.blend.w}` : null, NU ? `NHL usage weighted ${NU.w}` : null].filter(Boolean);
const season = `${P.seasonLabel.slice(0, 4)}–${P.seasonLabel.slice(5)}`;
const signed = (v, d = 1) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const age = Math.floor((Date.now() - new Date(B.birthDate)) / (365.25 * 24 * 3600 * 1000));
const ht = B.heightIn ? `${Math.floor(B.heightIn / 12)}′${B.heightIn % 12}″` : '';
const POSN = { C: 'Center', L: 'Left wing', R: 'Right wing', D: 'Defense', G: 'Goalie' };
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const nhlGp = LINES.filter((l) => l.league === 'NHL').reduce((a, l) => a + (l.gp || 0), 0);
const LEAGUE = { AHL: 'American Hockey League', WHL: 'Western Hockey League', OHL: 'Ontario Hockey League', QMJHL: 'Quebec Maritimes Junior Hockey League', NCAA: 'NCAA', SHL: 'Swedish Hockey League', Liiga: 'Liiga', NL: 'Swiss National League', ECHL: 'ECHL', USHL: 'USHL', KHL: 'KHL', 'WJC-20': 'World Juniors' };
// Pipeline Rankings: him plus the two ranked above and the two below
const PW = pipelineWindow(R?.rank);
const WORD = ['no', 'one', 'two', 'three', 'four'];
const nAbove = PW.filter((x) => x.rank < R?.rank).length, nBelow = PW.filter((x) => x.rank > R?.rank).length;
const around = nAbove && nBelow ? `the ${WORD[nAbove]} ranked above him and the ${WORD[nBelow]} below` : nAbove ? `the ${WORD[nAbove]} ranked above him` : `the ${WORD[nBelow]} ranked below him`;
const sinceLabel = rankStartDate ? `Since ${mdy(rankStartDate)}` : 'Move';
const lastLabel = `${Number(P.seasonLabel.slice(0, 4)) - 1}–${P.seasonLabel.slice(2, 4)}`;
---
<section class="sec">
  <div class="shell">
    <p class="kicker"><a href="/prospects/">Prospects</a> · {season}{twin ? <> · <a href={twin}>{P.prospectStatus?.onNhlRoster ? 'On the NHL roster: his NHL page' : 'His NHL page'}</a></> : null}</p>
    <div class="head">
      <div class="art"><Initials name={P.name} label={B.number != null ? `#${B.number}` : ''} /></div>
      <div class="who">
        <h1 class="page-title">{P.name}</h1>
        <p class="mono bio">#{B.number ?? '—'} · {POSN[B.position] ?? B.position} · shoots {B.shoots} · {ht}, {B.weightLb} lb · age {age} · {B.birthplace}</p>
      </div>
      <div class="scorebox">
        <span class="eb mono">Status</span>
        <span class="status">Prospect</span>
        <span class="mono range">rookie-eligible · {P.prospectStatus?.window ?? ''}{P.prospectStatus?.window ? ' · ' : ''}{nhlGp} NHL game{nhlGp === 1 ? '' : 's'} so far</span>
        {R && R.rank && <span class="mono range">pipeline rank {R.rank}{(R.score ?? C?.expected) != null ? ` · expected peak ${(R.score ?? C.expected).toFixed(0)}` : ''}</span>}
      </div>
    </div>
    <div class="grid">
      <div class="tile"><span class="eb mono">Drafted</span><span class="num">{B.draft ? `${B.draft.year}` : '—'}</span><span class="sub">{B.draft ? `${ordinal(B.draft.overallPick)} overall · round ${B.draft.round} · ${B.draft.teamAbbrev}` : 'undrafted'}</span></div>
      <div class="tile"><span class="eb mono">Age</span><span class="num">{age}</span><span class="sub">born {mdy(B.birthDate)}, {B.birthDate.slice(0, 4)}</span></div>
      <div class="tile"><span class="eb mono">This season{L.league ? ` · ${L.league}` : ''}</span><span class="num">{L.gp ?? '—'}</span><span class="sub">games{L.team ? ` · ${L.team}` : ''}{L.gp ? '' : ' · none yet'}</span></div>
      {B.position === 'G' ? (
        <div class="tile"><span class="eb mono">Save percentage</span><span class="num">{L.savePct != null ? sv3(L.savePct) : '—'}</span><span class="sub">{L.gaa != null ? `${Number(L.gaa).toFixed(2)} goals against average` : ''}{L.wins != null ? ` · ${L.wins}–${L.losses ?? 0}–${L.otLosses ?? 0}` : ''}</span></div>
      ) : (
        <div class="tile"><span class="eb mono">Goals · assists · points</span><span class="num">{L.goals ?? '—'}–{L.assists ?? '—'}–{L.points ?? '—'}</span><span class="sub">{L.plusMinus != null ? `${signed(L.plusMinus, 0)} · ` : ''}{L.pim != null ? `${L.pim} pim` : ''}</span></div>
      )}
    </div>
  </div>
</section>

{PW.length > 0 && (
<section class="sec" id="pipeline">
  <div class="shell">
    <h2>Pipeline Rankings</h2>
    <p class="lede">{ordinal(R.rank)} of {pipelineSize} Red Wings prospects, shown with {around}.</p>
    <div class="table-scroll pipe">
      <table>
        <thead><tr><th class="num">Rank</th><th>Player</th><th>Pos</th><th>League</th><th class="num" title="Network NHLe coefficient: a point in that league is worth this share of an NHL point">League strength</th><th class="num">GP</th><th class="num">G</th><th class="num">A</th><th class="num">P</th><th class="num" title={`Places moved since the start-of-season ranking on ${rankStartDate ? mdy(rankStartDate) : 'opening week'}`}>{sinceLabel}</th></tr></thead>
        <tbody>
          {PW.map((x) => {
            const l = x.line;
            return (
              <tr class:list={{ me: x.rank === R.rank }}>
                <td class="num">{x.rank}</td>
                <td>{x.href && x.rank !== R.rank ? <a href={x.href}>{x.name}</a> : x.name}</td>
                <td>{x.position}</td>
                <td>{l ? <span class:list={['tip', { mute: !l.now }]} title={`${l.team}${LEAGUE[l.league] && LEAGUE[l.league] !== l.league ? ` · ${LEAGUE[l.league]}` : ''}${l.now ? '' : ` · ${lastLabel}, no games yet this season`}`}>{l.league}{l.now ? '' : ` · ${lastLabel}`}</span> : '—'}{l?.also?.length ? <span class="mute"> +{l.also.join(', ')}</span> : null}</td>
                <td class="num">{l?.coef != null ? l.coef.toFixed(3) : '—'}</td>
                <td class="num">{l?.now ? (l.gp ?? 0) : '—'}</td>
                {x.group === 'G' ? (
                  <td class="num" colspan="3">{l?.now && l.svp ? `${l.svp} sv%` : '—'}</td>
                ) : (
                  <>
                    <td class="num">{l?.now ? (l.g ?? 0) : '—'}</td>
                    <td class="num">{l?.now ? (l.a ?? 0) : '—'}</td>
                    <td class="num">{l?.now ? (l.pts ?? 0) : '—'}</td>
                  </>
                )}
                <td class:list={['num', 'move', { up: x.move > 0, down: x.move < 0 }]}>{x.move == null ? 'new' : x.move > 0 ? `▲ ${x.move}` : x.move < 0 ? `▼ ${-x.move}` : '–'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="note mono">This season's line in each player's main league (the one with the most games). League strength is the Network NHLe coefficient from hockeystats.com. The ranking runs on last season's numbers until a player's current line reaches 10 games, then on this season's. {sinceLabel} counts the places moved from the start-of-season ranking.{PW.some((x) => x.line && !x.line.now) ? ` A league in grey with ${lastLabel} beside it means no games yet this season.` : ''}</p>
  </div>
</section>
)}

{R && A && (
<section class="sec" id="projection">
  <div class="shell">
    <h2>Where he projects</h2>
    <p class="lede">Four reads, every one measured against {posWord} only, built on his {A.season.slice(0, 4)}–{A.season.slice(7)} season{A.lines && A.lines.length > 1 ? ` across the ${A.lines.join(' and ')}` : ` in the ${A.league}`}.</p>
    <div class="grid layers">
      <div class="tile"><span class="eb mono">League strength</span><span class="num">{A.coef.toFixed(3)}</span><span class="sub">{A.league} coefficient · a point there is worth {Math.round(A.coef * 100)}% of an NHL point</span></div>
      <div class="tile"><span class="eb mono">{isGoalie ? 'Save percentage, age-relative' : 'Production, age-relative'}</span><span class="num">{pctWord(PF?.percentile)}</span><span class="sub">{PF && PF.percentile != null ? `percentile among ${PF.league.toUpperCase()} ${posWord} born ${R.birthDate.slice(0, 4)}, ${seasonLabel(PF.season)} (${PF.cohortN} of them)` : 'no same-year table for this league yet'}{isGoalie ? ` · ${sv3(A.svp)} against a league ${sv3(A.leagueSvp)}` : ` · NHLe ${A.nhle82.toFixed(1)} per 82`}</span></div>
      <div class="tile"><span class="eb mono">Ceiling</span><span class:list={['num', 'word', tierClass(C?.tier)]}>{C ? C.tier : '—'}</span><span class="sub">{C ? `the upside case, not the forecast: ${Math.round((C.pCeiling ?? 0) * 100)}% of ${C.n} comparable paths reached ${C.tier} or better; the 75th percentile lands at the ${ordinal(Math.round(C.p75))} percentile of NHL ${posWord} · expected peak ${R.score != null ? R.score.toFixed(0) : C.expected.toFixed(0)}${peakParts.length ? ` (cohort ${C.expected.toFixed(0)}, ${peakParts.join(', ')})` : ''} · ${Math.round(C.pRegular * 100)}% became NHL regulars` : 'not enough same-age comparables'}</span></div>
      <div class="tile"><span class="eb mono">Trajectory</span><span class="num">{TR ? (isGoalie ? featText(TR.delta) : sgn(TR.delta * 82, 1)) : '—'}</span><span class="sub">{TR ? `${isGoalie ? 'save percentage above league, in thousandths' : 'NHLe per 82'}: ${featText(TR.from.feature)} in the ${TR.from.league}, ${seasonLabel(TR.from.season)} to ${featText(TR.to.feature)} in the ${TR.to.league}, ${seasonLabel(TR.to.season)}` : 'needs two full seasons'}</span></div>
    </div>
    {C && C.examples && C.examples.length > 0 && (
      <div class="table-scroll comps">
        <table>
          <thead><tr><th>Closest paths at age {C.age}</th><th>Draft</th><th>League then</th><th class="num">{isGoalie ? 'SV% vs league' : 'NHLe / 82'}</th><th>NHL outcome</th><th class="num">NHL GP</th></tr></thead>
          <tbody>
            {C.examples.map((e) => (
              <tr><td>{e.name}</td><td>{e.year} · {e.pick}</td><td>{e.league}</td><td class="num">{featText(e.feature)}</td><td class:list={[tierClass(e.tier)]}>{e.tier}{e.peak != null ? <span class="mute"> · {ordinal(Math.round(e.peak))}</span> : null}</td><td class="num">{e.nhlGp}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {NU && NU.examples && NU.examples.length > 0 && (
      <div class="table-scroll comps">
        <table>
          <thead><tr><th>Closest NHL rookie seasons</th><th>Season</th><th class="num">Age</th><th class="num">GP</th><th class="num">TOI</th><th class="num">P/GP</th><th>NHL outcome</th><th class="num">NHL GP</th></tr></thead>
          <tbody>
            {NU.examples.map((e) => (
              <tr><td>{e.name}</td><td>{seasonLabel(e.season)}</td><td class="num">{e.age}</td><td class="num">{e.gp}</td><td class="num">{mmss(e.toi)}</td><td class="num">{e.ppg.toFixed(2)}</td><td class:list={[tierClass(e.tier)]}>{e.tier}{e.peak != null ? <span class="mute"> · {ordinal(Math.round(e.peak))}</span> : null}</td><td class="num">{e.nhlGp}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <div class="facts mono">
      {PD && <p><b>Draft pedigree.</b> Picks {PD.band} at the position, {PD.n} of them since 2008: {Math.round(PD.pRegular * 100)}% became NHL regulars, {Math.round(PD.pTopLine * 100)}% reached top-line production, expected peak {PD.expected.toFixed(0)}. {R.blend && R.blend.w > 0 ? `It carries weight ${R.blend.w} this season (${R.blend.sinceDraft <= 0 ? 'the draft year' : `draft+${R.blend.sinceDraft}`}); pedigree counts most in the draft year and nothing from draft+2.` : 'From draft+2 on it no longer moves the number.'}</p>}
      {PC && PC.percentile != null && <p><b>This season so far.</b> {pctWord(PC.percentile)} percentile among {PC.league.toUpperCase()} {posWord} born {R.birthDate.slice(0, 4)} after {PC.gp} games ({PC.cohortN} of them).</p>}
      {DP && DP.toiPerGame != null && <p><b>Deployment.</b> {DP.toiPerGame} minutes a game over {DP.games} logged games{DP.ppGoals ? `, ${DP.ppGoals} of ${DP.goals} goals on the power play` : ''}.</p>}
      {NU ? <p><b>NHL usage.</b> {NU.gp} games this season at {mmss(NU.toi)} a night, {R.nhlSample?.thisSeason?.pts ?? 0} point{(R.nhlSample?.thisSeason?.pts ?? 0) === 1 ? '' : 's'}. {posWord[0].toUpperCase() + posWord.slice(1)} who got that ice time as NHL rookies within a year of his age ({NU.n} closest of {NU.poolN}) reached an expected peak of {NU.expected.toFixed(0)}, and {Math.round(NU.pRegular * 100)}% became NHL regulars. It carries weight {NU.w} in his expected peak now and half at 20 games: {NU.before.toFixed(1)} without it, {NU.after.toFixed(1)} with it.</p> : R.nhlSample && R.nhlSample.gp > 0 && <p><b>NHL sample.</b> {R.nhlSample.gp} games{isGoalie ? '' : `, ${R.nhlSample.pts} points`}{R.nhlSample.thisSeason?.gp ? ` · ${R.nhlSample.thisSeason.gp} this season${R.nhlSample.thisSeason.toi ? ` at ${R.nhlSample.thisSeason.toi} a night` : ''}` : ''}. {isGoalie ? 'Goalie NHL games do not move the number yet.' : 'The NHL usage read starts at three NHL games this season.'}</p>}
      <p><b>Games behind the numbers.</b> {A.lineGp} in {seasonLabel(A.season)}{PF && PF.percentile != null ? `, ${PF.cohortN} same-year ${posWord} in the table` : ''}{C ? `, ${C.n} comparable paths from a pool of ${C.poolN}` : ''}.</p>
    </div>
    <p class="note mono">League strength is the Network NHLe points coefficient from hockeystats.com (Patrick Bacon). Production is points per game among skaters of the same position and the same age in the same league and season (EliteProspects tables). Ceiling: the nearest 50 drafted skaters of the 2008–2019 classes at the same position and age, matched on NHLe and draft slot, and where each one's best NHL season landed as a points-per-game percentile among regulars at the position; a player who never had a half-season in the NHL counts as zero. Tiers follow the W-Value on the NHL pages: elite 88+, top-line 73+, above average 50+, below average 27+. NHL usage, for a skater with three or more NHL games this season: the nearest 50 rookie NHL seasons (5+ games, 2008–2019 classes, through 2022–23) at his position within a year of his age, matched on ice time per game and, at half weight, on points per game pulled toward the group average while his sample is small; their mean peak blends into the expected peak at weight games ÷ (games + 20). NHL games are never matched against minor-league seasons.</p>
  </div>
</section>
)}

<section class="sec" id="lines">
  <div class="shell">
    <h2>Where he played</h2>
    <p class="lede">{SEASONS ? `Every line since ${R.draft ? `his draft year, ${R.draft.year}` : 'three seasons ago'}, newest first.` : `Every line from ${season}, by league.`} Counting stats only: no public expected-goals model covers the leagues below the NHL, so nothing here is presented as comparable across them.</p>
    <div class="table-scroll">
      <table>
        {isGoalie ? (
          <thead><tr><th>Season</th><th>League</th><th>Team</th><th class="num">GP</th><th class="num">W</th><th class="num">L</th><th class="num">GAA</th><th class="num">SV%</th><th class="num">SO</th></tr></thead>
        ) : (
          <thead><tr><th>Season</th><th>League</th><th>Team</th><th class="num">GP</th><th class="num">G</th><th class="num">A</th><th class="num">P</th><th class="num">+/−</th><th class="num">PIM</th></tr></thead>
        )}
        <tbody>
          {SEASONS ? SEASONS.flatMap((s) => s.lines.map((l, i) => (
            isGoalie ? (
              <tr class:list={{ nhl: l.league === 'NHL', first: i === 0 }}><td class="mono">{i === 0 ? seasonLabel(s.season) : ''}</td><td><span class="tip" title={LEAGUE[l.league] ?? l.league}>{l.league}</span></td><td>{l.team}</td><td class="num">{l.gp ?? '—'}</td><td class="num">{l.w ?? '—'}</td><td class="num">{l.l ?? '—'}</td><td class="num">{l.gaa ?? '—'}</td><td class="num">{l.svp ?? '—'}</td><td class="num">{l.so ?? '—'}</td></tr>
            ) : (
              <tr class:list={{ nhl: l.league === 'NHL', first: i === 0 }}><td class="mono">{i === 0 ? seasonLabel(s.season) : ''}</td><td><span class="tip" title={LEAGUE[l.league] ?? l.league}>{l.league}</span></td><td>{l.team}</td><td class="num">{l.gp ?? '—'}</td><td class="num">{l.g ?? '—'}</td><td class="num">{l.a ?? '—'}</td><td class="num">{l.pts ?? '—'}</td><td class="num">{l.pm != null ? signed(l.pm, 0) : '—'}</td><td class="num">{l.pim ?? '—'}</td></tr>
            )
          ))) : LINES.sort((a, b) => (b.league === 'NHL') - (a.league === 'NHL') || (b.gp || 0) - (a.gp || 0)).map((l) => (
            <tr class:list={{ nhl: l.league === 'NHL' }}><td class="mono">{season}</td><td><span class="tip" title={LEAGUE[l.league] ?? l.league}>{l.league}</span></td><td>{l.team}</td><td class="num">{l.gp ?? '—'}</td><td class="num">{l.goals ?? '—'}</td><td class="num">{l.assists ?? '—'}</td><td class="num">{l.points ?? '—'}</td><td class="num">{l.plusMinus != null ? signed(l.plusMinus, 0) : '—'}</td><td class="num">{l.pim ?? '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note mono">A W-Value arrives once he has an NHL season large enough to rate; until then he is listed with the prospects.</p>
  </div>
</section>

{G.length > 0 && (
<section class="sec" id="gamelog">
  <div class="shell">
    <h2>NHL game log</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Date</th><th>Opp</th><th class="num">TOI</th><th class="num">G</th><th class="num">A</th><th class="num">P</th><th class="num">+/−</th><th class="num">S</th><th class="num">Game score</th></tr></thead>
        <tbody>
          {[...G].reverse().map((g) => (
            <tr id={`g-${g.gameId}`}><td>{mdy(g.date)}</td><td>{g.home ? 'vs' : 'at'} {g.opponent}</td><td class="num">{g.toi.toFixed(1)}</td><td class="num">{g.goals}</td><td class="num">{g.assists}</td><td class:list={['num', { red: g.points >= 2 }]}>{g.points}</td><td class="num">{signed(g.plusMinus, 0)}</td><td class="num">{g.shots}</td><td class="num">{g.gameScore != null ? g.gameScore.toFixed(2) : '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note mono">Every NHL game last season, most recent first. Game score is Dom Luszczyszyn's formula via HockeyStatCards.</p>
  </div>
</section>
)}

<style>
  .kicker a { color: var(--mute); }
  .head { display: grid; grid-template-columns: 380px minmax(0, 1fr) auto; gap: 36px; align-items: end; margin: 0 0 28px; }
  .art { display: block; width: 380px; } .art img { width: 100%; height: auto; display: block; }
  .art.placeholder { aspect-ratio: 4 / 3; background: var(--ghost); border-radius: 3px; display: flex; align-items: flex-end; justify-content: flex-end; padding: 14px; color: var(--mute); font-size: 28px; }
  .who .page-title { margin-bottom: 10px; }
  .bio { color: var(--mute); text-transform: none; letter-spacing: 0; font-size: 12.5px; }
  .scorebox { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; text-align: right; border-left: 1px solid var(--rule); padding-left: 32px; }
  .scorebox .eb::before { content: "// "; } .scorebox .eb { color: var(--mute); }
  .status { font-size: 44px; font-weight: 600; letter-spacing: -.03em; line-height: 1; color: var(--red); text-transform: uppercase; }
  .range { color: var(--mute); }
  .lede { max-width: 66ch; font-size: 18px; line-height: 1.55; margin: 0 0 22px; }
  .note { color: var(--mute); font-size: 11px; margin: 10px 0 0; text-transform: none; letter-spacing: 0; max-width: 90ch; }
  .tip { border-bottom: 1px dotted var(--mute); cursor: help; }
  .layers .num.word { font-size: 26px; text-transform: capitalize; }
  .layers .num.word.elite, .layers .num.word.top { color: var(--red); }
