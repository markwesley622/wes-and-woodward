---
// A spider web shot at the viewer, in line art, for the Brandsegg-Nygård glow-up column (Peter Parker to Spider-Man).
// One flat drawing in a 400x225 frame, face on, black lines on the card grey, red used once (the hub, where the web
// left the wrist). No stacked layers: a web is flat, so the only depth cue is size (Mark 10/26). The loop is a CSS
// animation on the drawing's transform and opacity, never an SVG attribute, and it pauses off screen. One cycle: the
// web appears small in the middle of the frame, grows faster and faster while it spins (coming at the camera),
// overshoots the frame a little as it hits the glass, settles, holds, fades, and resets. At rest (reduced motion,
// link-preview images, data-still) it holds the full-frame pose. Drawing (10/26): ten spokes, eight capture-spiral
// rings that sag toward the hub between spokes, two broken threads.
const { id = 'spiderweb' } = Astro.props;
const CX = 200, CY = 112, SPOKES = 10, RINGS = [16, 30, 48, 70, 96, 126, 160, 198];
const pt = (r, k) => { const a = (-Math.PI / 2) + (k * 2 * Math.PI) / SPOKES + 0.11; return [CX + r * Math.cos(a), CY + r * Math.sin(a)]; };
const f = (n) => n.toFixed(1);
const spokes = Array.from({ length: SPOKES }, (_, k) => { const [x, y] = pt(190, k); return `M ${CX} ${CY} L ${f(x)} ${f(y)}`; });
// each ring is a closed run of quadratic curves whose control point is pulled toward the hub, so the thread sags
const rings = RINGS.map((r, i) => {
  const sag = 0.90 - i * 0.012, skip = i === 4 ? 6 : i === 6 ? 1 : -1;   // two rings miss a span: broken threads
  let d = '';
  for (let k = 0; k < SPOKES; k++) {
    const [x0, y0] = pt(r, k), [x1, y1] = pt(r, (k + 1) % SPOKES);
    const mx = (x0 + x1) / 2, my = (y0 + y1) / 2;
    const cx = CX + (mx - CX) * sag, cy = CY + (my - CY) * sag;
    if (k === skip) continue;
    d += `M ${f(x0)} ${f(y0)} Q ${f(cx)} ${f(cy)} ${f(x1)} ${f(y1)} `;
  }
  return d.trim();
});
---
<div class="sw" id={id} aria-hidden="true">
  <svg class="web" viewBox="0 0 400 225">
    {spokes.map((d) => <path d={d} />)}
    {rings.map((d) => <path d={d} />)}
    <circle cx={CX} cy={CY} r="3.2" class="hub" />
  </svg>
</div>

<style>
  .sw { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ghost); border-radius: 3px; }
  .web { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; will-change: transform, opacity; transform: rotate(8deg) scale(1); }
  .web path { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .hub { fill: var(--red); stroke: none; }
  /* the shot: small in the middle, grow and spin faster and faster, hit the glass and settle, fade out, reset; paused until on screen */
  .web { animation: sw-shot 6.5s infinite paused; }
  .sw[data-live] .web { animation-play-state: running; }
  .sw[data-still] .web { animation: none; }
  @keyframes sw-shot {
    0%   { transform: rotate(-70deg) scale(.04); opacity: 0; animation-timing-function: linear; }
    8%   { transform: rotate(-70deg) scale(.04); opacity: 1; animation-timing-function: cubic-bezier(.6, 0, .9, .45); }
    38%  { transform: rotate(10deg) scale(1.08); opacity: 1; animation-timing-function: cubic-bezier(.3, 0, .4, 1); }
    44%  { transform: rotate(7deg) scale(.98); opacity: 1; animation-timing-function: cubic-bezier(.4, 0, .6, 1); }
    50%  { transform: rotate(8deg) scale(1); opacity: 1; animation-timing-function: linear; }
    88%  { transform: rotate(8deg) scale(1); opacity: 1; animation-timing-function: ease-in; }
    96%  { transform: rotate(8deg) scale(1); opacity: 0; }
    100% { transform: rotate(-70deg) scale(.04); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .web { animation: none; } }
</style>

<script define:vars={{ id }}>
  // the loop only runs while the thumbnail is on screen; ?t=0..1 freezes it at that point of the cycle for screenshots
  const el = document.getElementById(id);
  if (el) {
    const t = new URLSearchParams(location.search).get('t');
    if (t !== null) { const w = el.querySelector('.web'); w.style.animationDelay = `${-(parseFloat(t) * 6.5)}s`; el.setAttribute('data-live', ''); w.style.animationPlayState = 'paused'; }
    else new IntersectionObserver(([e]) => el.toggleAttribute('data-live', e.isIntersecting)).observe(el);
  }
</script>
