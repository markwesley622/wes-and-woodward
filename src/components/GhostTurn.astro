---
// A friendly ghost in line art (Kasper, as in Casper), extruded by stacking SVG layers down the Z axis the way
// FlipLetter builds its slab. While the thumbnail is on screen the ghost floats: a slow sway on its vertical axis
// and a gentle bob. Front-half layers carry the outline; back-half layers carry the mirrored outline and are
// turned 180deg, so with backface-visibility hidden the slab reads as one solid from either side. Only the front
// face carries the eyes, the smile and the red sparkle trail. The loop is a CSS animation on element transforms,
// never an SVG attribute, and it pauses off screen; scroll no longer drives it (Mark, 10/17: the scroll-linked
// version made the homepage feel glitchy). Original drawing (Mark, 10/13), not a trace of the Casper art.
const { id = 'ghostturn' } = Astro.props;
const N = 14, STEP = 3, depth = (N - 1) * STEP;
const BODY = 'M160 105 C146 46 184 14 214 16 C250 18 266 54 254 92 C264 80 274 62 278 48 C282 36 300 38 298 52 C296 70 280 96 258 112 C252 142 236 168 210 186 C180 205 140 212 118 200 C140 198 166 186 178 170 C184 160 178 140 170 132 C160 138 146 142 140 136 C136 130 146 122 158 120 C162 118 162 110 160 105 Z';
const SPARKS = [[109, 205, 2.6], [98, 197, 1.9], [91, 186, 1.4], [101, 214, 1.7], [86, 207, 1.3], [80, 194, 1]];
const layers = Array.from({ length: N }, (_, i) => {
  const z = -i * STEP;                                   // 0 is the face, -depth is the back
  return { z, isBack: i >= N / 2, edge: i === 0 || i === N - 1, face: i === 0 };
});
---
<div class="gt" id={id} aria-hidden="true">
  <div class="block">
    {layers.map((l) => (
      <svg class:list={['layer', { edge: l.edge }]} viewBox="0 0 400 225"
        style={l.isBack ? `transform:translateZ(${(l.z + depth / 2).toFixed(1)}px) rotateY(180deg)` : `transform:translateZ(${(l.z + depth / 2).toFixed(1)}px)`}>
        <path d={BODY} class="body" transform={l.isBack ? 'translate(400 0) scale(-1 1)' : undefined} />
        {l.face && (
          <g>
            <ellipse cx="194" cy="58" rx="7" ry="10" class="body" />
            <ellipse cx="224" cy="56" rx="7" ry="10" class="body" />
            <path d="M198 81 Q210 92 222 81" class="body" />
            {SPARKS.map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="spark" />)}
          </g>
        )}
      </svg>
    ))}
  </div>
</div>

<style>
  .gt { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ghost); border-radius: 3px; perspective: 900px; perspective-origin: 50% 45%; }
  .block { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; transform: rotateX(6deg) rotateY(-24deg); }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; backface-visibility: hidden; overflow: visible; }
  .body { fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round; opacity: .42; }
  .edge .body { stroke-width: 2; opacity: 1; }
  .spark { fill: var(--red); stroke: none; }
  /* sway (transform) and bob (translate) on different periods so the float never looks like one canned move;
     paused until the thumbnail is on screen */
  .block { animation: gt-sway 7s infinite paused, gt-bob 3.4s ease-in-out infinite paused; }
  .gt[data-live] .block { animation-play-state: running; }
  .gt[data-still] .block { animation: none; }
  @keyframes gt-sway {
    0% { transform: rotateX(6deg) rotateY(-24deg); animation-timing-function: cubic-bezier(.33, .66, .66, 1); }
    25% { transform: rotateX(6deg) rotateY(-46deg); animation-timing-function: cubic-bezier(.45, 0, .55, 1); }
    75% { transform: rotateX(6deg) rotateY(-2deg); animation-timing-function: cubic-bezier(.33, 0, .66, .33); }
    100% { transform: rotateX(6deg) rotateY(-24deg); }
  }
  @keyframes gt-bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -3.5%; } }
  @media (prefers-reduced-motion: reduce) { .block { animation: none; } }
</style>

<script define:vars={{ id }}>
  // the loop only runs while the thumbnail is on screen
  const el = document.getElementById(id);
  if (el) new IntersectionObserver(([e]) => el.toggleAttribute('data-live', e.isIntersecting)).observe(el);
</script>
