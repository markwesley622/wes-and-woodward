---
// End-of-article follow box: the email form when the Buttondown list is configured (src/lib/follow.js), the feed link always.
import { FEED, subscribeAction } from '../lib/follow.js';
const action = subscribeAction();
---
<aside class="sub" aria-labelledby="sub-h">
  <p class="mono sub-h" id="sub-h">Get the next one</p>
  <p class="sub-p">One email when a new article is published. Nothing else.</p>
  {action ? (
    <form class="sub-form" action={action} method="post">
      <label class="vh" for="sub-email">Email address</label>
      <input id="sub-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit" class="mono">Subscribe</button>
    </form>
  ) : null}
  <p class="mono lc sub-note">Feed reader? <a href={FEED}>RSS</a></p>
</aside>

<style>
  .sub { box-sizing: border-box; max-width: min(68ch, 100%); margin: 44px 0 0; padding: 22px 24px; border: 1px solid var(--ink); }
  .sub-h { margin: 0 0 8px; color: var(--mute); }
  .sub-h::before { content: "// "; color: var(--red); }
  .sub-p { margin: 0 0 14px; font-size: 16px; line-height: 1.5; max-width: 48ch; }
  .sub-form { display: flex; max-width: 400px; }
  .sub-form input[type="email"] { flex: 1; min-width: 0; font: 15px var(--sans); padding: 10px 12px; border: 1px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); }
  .sub-form input[type="email"]:focus { outline: 2px solid var(--red); outline-offset: -1px; }
  .sub-form button { padding: 0 16px; border: 1px solid var(--ink); border-left: 0; border-radius: 0; background: var(--ink); color: var(--paper); cursor: pointer; }
  .sub-form button:hover { background: var(--red); border-color: var(--red); }
  .sub-note { margin: 12px 0 0; font-size: 12px; color: var(--mute); }
  .sub-note a { color: var(--ink); text-decoration: underline; }
  .sub-note a:hover { color: var(--red); }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
