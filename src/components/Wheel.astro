---
// The Red Wings wheel as a 3D object: line-art face + back, tread wall of stacked rings.
// Spokes roll with scroll; the tire (and its brushed highlight) stays fixed as a lighting cue.
import parts from '../../design/wheel-parts.json';
const N = 30, STEP = 5;
const C = 2 * Math.PI * 415, blocks = 48, dash = (C / blocks) * 0.72, gap = C / blocks - dash;
const layers = Array.from({ length: N }, (_, i) => i + 1).filter((i) => i !== 10 && i !== 20)
  .map((i) => ({ z: -i * STEP, dash: `${dash.toFixed(2)} ${gap.toFixed(2)}`, off: ((10 < i && i < 20) ? C / blocks / 2 : 0).toFixed(2) }));
const depth = N * STEP;
---
<div class="stage" id="wheel-stage" aria-hidden="true">
  <div class="wheel" id="wheel">
    <div class="back" style={`transform:translateZ(${-depth}px)`}>
      <svg viewBox={parts.viewBox}><path class="tire" d={parts.tire} /><path class="spin" d={parts.spokes} /></svg>
    </div>
    <div class="tread">
      <svg class="tl" viewBox="0 0 840 840" style="transform:translateZ(-1px)"><circle cx="420" cy="420" r="415" class="edge" /></svg>
      {layers.map((l) => (
        <svg class="tl" viewBox="0 0 840 840" style={`transform:translateZ(${l.z}px)`}>
          <circle cx="420" cy="420" r="415" stroke-dasharray={l.dash} stroke-dashoffset={l.off} />
        </svg>
      ))}
      <svg class="tl" viewBox="0 0 840 840" style={`transform:translateZ(${-depth - 1}px)`}><circle cx="420" cy="420" r="415" class="edge" /></svg>
    </div>
    <div class="face" style="transform:translateZ(0.5px)">
      <svg viewBox={parts.viewBox}><path class="tire" d={parts.tire} /><path class="spin" d={parts.spokes} /></svg>
    </div>
  </div>
</div>

<style>
  .stage { position: absolute; right: -6vw; top: -6vh; width: min(1040px, 86vw); aspect-ratio: 1; perspective: 1900px; perspective-origin: 50% 40%; z-index: 1; transform: translateY(var(--ty, 0px)); will-change: transform; }
  .wheel { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(var(--tilt, 6deg)); will-change: transform; }
  .face, .back, .tread { position: absolute; inset: 0; transform-style: preserve-3d; }
  .face svg, .back svg, .tl { position: absolute; inset: 0; width: 100%; height: 100%; }
  path { fill: none; stroke: var(--ink); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  circle { fill: none; stroke: var(--ink); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  circle.edge { stroke-width: 1.6; }
  .spin { transform-box: fill-box; transform-origin: center; transform: rotate(var(--spin, 0deg)); }
  .tread { transform: rotate(var(--spin, 0deg)); opacity: var(--tread, 0.35); }
  @media (max-width: 900px) { .stage { right: -22vw; top: 44vh; width: 124vw; } }
  @media (prefers-reduced-motion: reduce) { .wheel { transform: rotateX(28deg) !important; } .tread { opacity: 1; } }
</style>

<script>
  const wheel = document.getElementById('wheel');
  const stage = document.getElementById('wheel-stage');
  const hero = document.querySelector('.hero');
  if (wheel && stage && hero) {
    const q = new URLSearchParams(location.search);
    const fixedSy = q.has('sy') ? parseFloat(q.get('sy')) : null;
    if (fixedSy !== null) document.body.style.marginTop = -fixedSy + 'px';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TILT_MIN = 6, TILT_MAX = 74, ROLL = 420;
    const t0 = performance.now();
    let queued = false;
    function frame(now) {
      queued = false;
      const h = hero.offsetHeight;
      const range = h - innerHeight * 0.35;
      const sy = fixedSy !== null ? fixedSy : scrollY;
      const p = Math.min(1, Math.max(0, sy / range));
      const tilt = TILT_MIN + p * (TILT_MAX - TILT_MIN);
      const spin = reduce ? 0 : ((now - t0) / 1000) * 4 + p * ROLL;
      wheel.style.setProperty('--tilt', tilt.toFixed(2) + 'deg');
      wheel.style.setProperty('--spin', spin.toFixed(2) + 'deg');
      wheel.style.setProperty('--tread', Math.min(1, 0.18 + p * 2.2).toFixed(3));
      stage.style.setProperty('--ty', (0.55 * Math.min(sy, 1.5 * h)).toFixed(1) + 'px');
      if (!reduce && sy < 2.2 * h) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(frame); } }, { passive: true });
  }
</script>
