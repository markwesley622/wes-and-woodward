---
// A block letter in the Initials family (stroke-only display face, extruded by stacking SVG layers
// down the Z axis) that turns on its vertical axis while the thumbnail is on screen. The front of
// the slab is carved with one letter and the back with another, so a half turn reads as a different
// letter: O, then D once it has swung round (Mark, 10/7), holding on each before turning on. Front-
// half layers face forward and carry the front letter; back-half layers are turned 180deg and carry
// the back letter, so with backface-visibility hidden each half is only ever seen from its own side.
// The loop is a CSS animation on an element transform, never an SVG attribute, and it pauses off
// screen; scroll no longer drives it (Mark, 10/17: the scroll-linked version felt glitchy). At rest
// (reduced motion, link-preview images) it shows the back letter.
const { id = 'flipletter', front = 'O', back = 'D' } = Astro.props;
const N = 16, STEP = 4, depth = (N - 1) * STEP;
const layers = Array.from({ length: N }, (_, i) => {
  const z = -i * STEP;                                   // 0 is the face, -depth is the back
  const isBack = i >= N / 2;
  return { z, isBack, edge: i === 0 || i === N - 1 };
});
const SIZE = 250;
---
<div class="fl" id={id} aria-hidden="true">
  <div class="block">
    {layers.map((l) => (
      <svg class:list={['layer', { edge: l.edge }]} viewBox="0 0 400 225"
        style={l.isBack ? `transform:translateZ(${(l.z + depth / 2).toFixed(1)}px) rotateY(180deg)` : `transform:translateZ(${(l.z + depth / 2).toFixed(1)}px)`}>
        <text x="200" y="202" style={`font-size:${SIZE}px`}>{l.isBack ? back : front}</text>
      </svg>
    ))}
  </div>
</div>

<style>
  .fl { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ghost); border-radius: 3px; perspective: 900px; perspective-origin: 50% 45%; }
  .block { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; transform: rotateX(8deg) rotateY(180deg); }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; backface-visibility: hidden; }
  text { font-family: var(--sans); font-weight: 700; letter-spacing: -.04em; text-anchor: middle; fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-linejoin: round; opacity: .42; }
  .edge text { stroke-width: 2; opacity: 1; }
  /* hold the front letter, half turn, hold the back letter, half turn on round to the front; paused until on screen */
  .block { animation: fl-turn 8s infinite paused; }
  .fl[data-live] .block { animation-play-state: running; }
  .fl[data-still] .block { animation: none; }
  @keyframes fl-turn {
    0%, 30% { transform: rotateX(8deg) rotateY(0deg); animation-timing-function: cubic-bezier(.65, 0, .35, 1); }
    50%, 80% { transform: rotateX(8deg) rotateY(180deg); animation-timing-function: cubic-bezier(.65, 0, .35, 1); }
    100% { transform: rotateX(8deg) rotateY(360deg); }
  }
  @media (prefers-reduced-motion: reduce) { .block { animation: none; } }
</style>

<script define:vars={{ id }}>
  // the loop only runs while the thumbnail is on screen
  const el = document.getElementById(id);
  if (el) new IntersectionObserver(([e]) => el.toggleAttribute('data-live', e.isIntersecting)).observe(el);
</script>
