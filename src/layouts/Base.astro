---
import '../styles/global.css';
import wordmarkRaw from '../../brand/wes-and-woodward-wordmark-black.svg?raw';
import D from '../../data/site/dashboard.json';
import { termCards, LABELS } from '../lib/terms.js';
import { glossary } from '../lib/glossary.js';

const { title = 'Wes & Woodward', description = 'Detroit hockey, by the numbers.', schema = null, ogType = 'website' } = Astro.props;
const base = import.meta.env.BASE_URL;
// structured data: the site and its publisher on every page, plus whatever the page passes in
const SITE = 'https://wesandwoodward.com';
// a page may name another page as canonical (a prospect's NHL page and prospect page point at whichever matches his current status)
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, SITE).href;
const ORG = { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'Wes & Woodward', url: `${SITE}/`, description: 'Independent Detroit Red Wings analytics: expected goals, player value and season simulations, written in Detroit.',
  logo: { '@type': 'ImageObject', '@id': `${SITE}/#logo`, url: `${SITE}/icon-512.png`, contentUrl: `${SITE}/icon-512.png`, width: 512, height: 512, caption: 'Wes & Woodward W' },
  image: { '@id': `${SITE}/#logo` }, knowsAbout: ['Detroit Red Wings', 'National Hockey League', 'hockey analytics', 'expected goals'] };
const WEBSITE = { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Wes & Woodward', alternateName: 'Wes and Woodward', url: `${SITE}/`, publisher: { '@id': `${SITE}/#org` }, inLanguage: 'en-US' };
const pageNodes = schema ? (Array.isArray(schema) ? schema : [schema]) : [{ '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, isPartOf: { '@id': `${SITE}/#website` } }];
// player pages (memberOf) and articles (about) point at the team by @id; carry the node so the reference resolves off /team/ too
const TEAM = { '@type': 'SportsTeam', '@id': `${SITE}/team/#team`, name: 'Detroit Red Wings', sport: 'Ice hockey', url: `${SITE}/team/` };
const teamNode = JSON.stringify(pageNodes).includes(TEAM['@id']) && !pageNodes.some((n) => n['@id'] === TEAM['@id']) ? [TEAM] : [];
// breadcrumb trail from the URL: Home, then the section index where one exists, then this page (named from its title)
const SECTIONS = { players: 'Players', prospects: 'Prospects', glossary: 'Glossary' };
const here = new URL(Astro.url.pathname, SITE).href, segs = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = segs.length ? [{ name: 'Home', item: `${SITE}/` }, ...(segs.length > 1 && SECTIONS[segs[0]] ? [{ name: SECTIONS[segs[0]], item: `${SITE}/${segs[0]}/` }] : []),
  { name: Astro.props.crumb ?? title.replace(/ (—|\|) Wes & Woodward$/, '').replace(/ — Prospect$/, ''), item: here }] : [];
const breadcrumb = crumbs.length ? [{ '@type': 'BreadcrumbList', '@id': `${here}#breadcrumb`, itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })) }] : [];
const graph = { '@context': 'https://schema.org', '@graph': [ORG, WEBSITE, ...pageNodes, ...teamNode, ...breadcrumb] };
const wordmark = wordmarkRaw.replace('<svg ', '<svg class="wm" role="img" aria-label="Wes and Woodward" ').replace('fill="#000000"', 'fill="currentColor"');

// season banner
const S = D.standings, NG = D.nextGame;
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const season = `${D.seasonLabel.slice(0, 4)}–${D.seasonLabel.slice(5)}`;
const vs = (g) => (g.home ? 'vs' : 'at');
const record = `${S.wins}–${S.losses}–${S.otLosses} · ${S.points} pts · ${ordinal(S.division.place)} in the ${S.division.name}`;
let banner = `${season} · ${record}`;
if (D.seasonState === 'offseason') {
  banner = `${season} final · ${record}`;
  if (NG) banner += ` · ${NG.season.slice(0, 4)}–${NG.season.slice(6)} opens ${mdy(NG.date)} ${vs(NG)} ${NG.opponent}`;
}
// preseason and in-season: just `season · record` (Mark's copy, 9/23)
// global footer: sections, reference (glossary lives here, not in the header), the glossary's pages, data credits
const footSections = [['Team', `${base}team/`], ['Players', `${base}players/`], ['Prospects', `${base}prospects/`], ['Analysis', `${base}#analysis`]];
const footReference = [['Glossary', `${base}glossary/`], ['About', `${base}about/`]];
// eight pages the footer points at: the site's core analytics stats, then the biggest search themes (stat_themes.json)
const FOOT_GLOSSARY = ['expected-goals', 'corsi', 'goals-saved-above-expected', 'pdo', 'shots-on-goal', 'penalty-minutes', 'plus-minus', 'save-percentage'];
const footGlossary = FOOT_GLOSSARY.map((slug) => glossary.find((g) => g.slug === slug)).filter(Boolean).map((g) => [g.stat.name, `${base}glossary/${g.slug}/`]);
const footData = [['NHL API', 'https://api-web.nhle.com'], ['MoneyPuck', 'https://moneypuck.com'], ['HockeyStatCards', 'https://hockeystatcards.com'],
  ['Natural Stat Trick', 'https://www.naturalstattrick.com'], ['Evolving-Hockey', 'https://evolving-hockey.com'], ['Elite Prospects', 'https://www.eliteprospects.com']];
const termData = JSON.stringify({ cards: termCards, labels: LABELS });
const nav = [['Team', `${base}team/`], ['Players', `${base}players/`], ['Prospects', `${base}prospects/`], ['Analysis', `${base}#analysis`], ['About', `${base}about/`]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:image" content="https://wesandwoodward.com/icon-512.png" />
    <meta property="og:site_name" content="Wes & Woodward" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <div class="page">
    <div class="banner mono lc">{banner}</div>
    <header class="hdr">
      <div class="shell">
        <div class="top">
          <a class="home" href={base} aria-label="Wes and Woodward, home" set:html={wordmark} />
          <div class="right">
            <nav class="nav mono" aria-label="Primary">
              {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            </nav>
            <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
      </div>
      <nav class="menu mono" id="mobile-menu" aria-label="Primary, mobile" hidden>
        <div class="shell">
          {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <div class="shell">
        <div class="foot-top">
          <div class="foot-brand">
            <a class="foot-home" href={base} aria-label="Wes and Woodward, home" set:html={wordmark} />
            <p class="foot-tag">Detroit hockey, by the numbers. Dashboards rebuild every night.</p>
          </div>
          <nav class="foot-cols" aria-label="Footer">
            <div class="foot-col">
              <p class="mono foot-h">Sections</p>
              {footSections.map(([label, href]) => <a href={href}>{label}</a>)}
            </div>
            <div class="foot-col">
              <p class="mono foot-h">Reference</p>
              {footReference.map(([label, href]) => <a href={href}>{label}</a>)}
            </div>
            {footGlossary.length > 0 && (
              <div class="foot-col">
                <p class="mono foot-h">Glossary</p>
                {footGlossary.map(([label, href]) => <a href={href}>{label}</a>)}
                <a class="foot-all" href={`${base}glossary/`}>All stats →</a>
              </div>
            )}
            <div class="foot-col">
              <p class="mono foot-h">Data</p>
              {footData.map(([label, href]) => <a href={href} rel="noopener">{label}</a>)}
            </div>
          </nav>
        </div>
        <div class="foot-base mono lc">
          <p>Wes &amp; Woodward is an independent publication and is not affiliated with the Detroit Red Wings or the NHL.</p>
          <p>© {new Date().getFullYear()} Wes &amp; Woodward</p>
        </div>
      </div>
    </footer>
    </div>
    <script type="application/json" id="term-data" set:html={termData} />
    <script>
      // Hover definitions: any stat label that matches a glossary term (or carries data-term) opens a small card with
      // the term's short definition and, when the stat has a glossary page, a "Full definition" link. Mouse: hover
      // (the card stays open while the pointer moves into it). Keyboard: focus, Tab moves into the link, Esc closes.
      // Touch: tap the label (sortable headers keep their tap for sorting).
      (() => {
        const el = document.getElementById('term-data');
        if (!el) return;
        const { cards, labels } = JSON.parse(el.textContent);
        const norm = (t) => t.replace(/[\u2212\u2013]/g, '-').replace(/[↑↓▲▼]/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
        const here = location.pathname;
        document.querySelectorAll('th, .eb, .tip, [data-term]').forEach((n) => {
          const id = n.dataset.term || labels[norm(n.textContent)];
          if (!id || id === 'none' || !cards[id] || n.closest('.term-card')) return;
          n.dataset.term = id;
          n.classList.add('term');
          if (n.title) { n.dataset.note = n.title; n.removeAttribute('title'); }
          if (!n.matches('a, button, [tabindex]')) n.tabIndex = 0;
        });
        if (!document.querySelector('[data-term].term')) return;

        const card = document.createElement('div');
        card.className = 'term-card';
        card.id = 'term-card';
        card.setAttribute('role', 'tooltip');
        card.hidden = true;
        document.body.appendChild(card);
        let owner = null, openT = 0, closeT = 0, lastPtr = 'mouse', openedAt = 0, quiet = null;
        document.addEventListener('pointerdown', (e) => { lastPtr = e.pointerType || 'mouse'; }, { capture: true });

        const esc = (t) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const place = (n) => {
          const r = n.getBoundingClientRect(), w = card.offsetWidth, h = card.offsetHeight, gap = 8, pad = 16;
          let x = Math.min(Math.max(pad, r.left), innerWidth - w - pad);
          let y = r.bottom + gap;
          if (y + h > innerHeight - pad && r.top - gap - h > pad) y = r.top - gap - h;
          card.style.left = `${x + scrollX}px`;
          card.style.top = `${y + scrollY}px`;
        };
        const open = (n) => {
          clearTimeout(closeT);
          if (owner === n && !card.hidden) return;
          const c = cards[n.dataset.term];
          const link = c.h && c.h !== here ? `<a class="term-full mono" href="${c.h}">Full definition →</a>` : '';
          const note = n.dataset.note ? `<p class="term-note mono lc">${esc(n.dataset.note)}</p>` : '';
          card.innerHTML = `<p class="term-k mono">${esc(c.n)}${c.a ? ` <span>${esc(c.a)}</span>` : ''}</p><p class="term-d">${esc(c.d)}</p>${note}${link}`;
          if (owner) owner.removeAttribute('aria-describedby');
          owner = n;
          n.setAttribute('aria-describedby', 'term-card');
          card.hidden = false;
          openedAt = Date.now();
          place(n);
        };
        const close = () => { clearTimeout(openT); card.hidden = true; if (owner) owner.removeAttribute('aria-describedby'); owner = null; };
        const later = () => { clearTimeout(openT); clearTimeout(closeT); closeT = setTimeout(close, 180); };

        document.addEventListener('pointerover', (e) => {
          if (e.pointerType !== 'mouse') return;
          const n = e.target.closest('.term');
          if (n) { clearTimeout(closeT); clearTimeout(openT); openT = setTimeout(() => open(n), 120); }
          else if (e.target.closest('.term-card')) clearTimeout(closeT);
        });
        document.addEventListener('pointerout', (e) => {
          if (e.pointerType !== 'mouse') return;
          const from = e.target.closest('.term, .term-card'), to = e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest('.term, .term-card');
          if (from && from !== to) later();
        });
        document.addEventListener('click', (e) => {
          const n = e.target.closest('.term');
          // a tap focuses the label (which opens the card) and then clicks it: only a later tap on the same label closes it
          if (n && lastPtr !== 'mouse' && !n.matches('[data-sort], a, button')) { owner === n && !card.hidden && Date.now() - openedAt > 400 ? close() : open(n); return; }
          if (!e.target.closest('.term-card')) close();
        });
        document.addEventListener('focusin', (e) => {
          const n = e.target.closest('.term');
          if (n && n === quiet) { quiet = null; return; }
          if (n) open(n); else if (!e.target.closest('.term-card')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !card.hidden) { const o = owner; close(); if (o) { quiet = o; o.focus(); } }
          if (e.key === 'Tab' && !e.shiftKey && owner && document.activeElement === owner && !card.hidden) {
            const a = card.querySelector('a'); if (a) { e.preventDefault(); a.focus(); }
          }
          if (e.key === 'Tab' && e.shiftKey && document.activeElement && document.activeElement.closest('.term-card') && owner) { e.preventDefault(); owner.focus(); }
        });
        addEventListener('scroll', () => { if (!card.hidden && owner) place(owner); }, { passive: true });
        addEventListener('resize', close);
      })();
    </script>
    <script>
      // Header: hides on a deliberate scroll down, returns on any scroll up, and also
      // whenever the pointer comes to the top of the window or focus lands in the header,
      // so it is never a guess where the nav went.
      (() => {
        const hdr = document.querySelector('.hdr');
        if (!hdr) return;
        let last = window.scrollY, downRun = 0, queued = false;
        const show = () => hdr.classList.remove('is-hidden');
        const update = () => {
          const y = window.scrollY, dy = y - last;
          if (y <= 8 || hdr.classList.contains('menu-open')) { show(); downRun = 0; }
          else if (dy < -2) { show(); downRun = 0; }
          else if (dy > 0) { downRun += dy; if (downRun > 24 && y > hdr.offsetHeight + 40) hdr.classList.add('is-hidden'); }
          last = y; queued = false;
        };
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('mousemove', (e) => { if (e.clientY < 72) { show(); downRun = 0; } }, { passive: true });
        hdr.addEventListener('focusin', show);
        hdr.addEventListener('mouseenter', show);
      })();
      // Mobile burger menu.
      (() => {
        const hdr = document.querySelector('.hdr'), btn = document.querySelector('.burger'), menu = document.getElementById('mobile-menu');
        if (!hdr || !btn || !menu) return;
        const set = (open) => { hdr.classList.toggle('menu-open', open); menu.hidden = !open; btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
        btn.addEventListener('click', () => set(!hdr.classList.contains('menu-open')));
        menu.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
        addEventListener('resize', () => { if (innerWidth > 560) set(false); });
      })();
      // Section headings: the text slides out from behind the red "//" when the heading scrolls into view.
      (() => {
        const heads = document.querySelectorAll('.sec h2');
        if (!heads.length) return;
        heads.forEach((h) => {
          const wrap = document.createElement('span'); wrap.className = 'h2-wrap';
          const txt = document.createElement('span'); txt.className = 'h2-txt';
          while (h.firstChild) txt.appendChild(h.firstChild);
          wrap.appendChild(txt); h.appendChild(wrap); h.classList.add('h2-reveal');
        });
        if (!('IntersectionObserver' in window)) { heads.forEach((h) => h.classList.add('in')); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.6 });
        heads.forEach((h) => io.observe(h));
      })();
    </script>
  </body>
</html>

<style>
  /* iOS ignores overflow-x on html/body for pinch-pan; an inner wrapper with clip is the reliable fence. clip (not hidden) keeps the sticky header working. */
  .page { overflow-x: clip; position: relative; }
  .banner { background: var(--red); color: #fff; text-align: center; padding: 7px 12px; font-size: 12px; }
  /* Sticky header: hides on scroll down, returns on any scroll up. Banner scrolls away normally. */
  .hdr { position: sticky; top: 0; z-index: 6; background: var(--paper); transform: translateY(0); transition: transform 240ms ease; will-change: transform; }
  .hdr.is-hidden { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .hdr { transition: none; } }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 64px; border-bottom: 1px solid var(--rule); }
  .home { color: var(--ink); display: block; }
  .home :global(.wm) { height: 30px; width: auto; }
  .right { display: flex; align-items: center; gap: 28px; }
  .nav { display: flex; gap: 24px; }
  .foot { margin-top: 0; padding: 56px 0 40px; border-top: 1px solid var(--ink); }
  .foot-top { display: grid; grid-template-columns: minmax(220px, 1fr) 2.4fr; gap: 48px; padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .foot-home { color: var(--ink); display: inline-block; }
  .foot-home :global(.wm) { height: 28px; width: auto; }
  .foot-tag { margin: 14px 0 0; max-width: 30ch; color: var(--mute); font-size: 14px; line-height: 1.5; }
  .foot-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .foot-col { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .foot-h { margin: 0 0 4px; color: var(--mute); }
  .foot-h::before { content: "// "; color: var(--red); }
  .foot-col a { font-size: 15px; line-height: 1.3; }
  .foot-col a:hover { color: var(--red); }
  .foot-all { color: var(--red); font-size: 13px !important; margin-top: 2px; }
  .foot-base { display: flex; justify-content: space-between; gap: 24px; padding-top: 20px; color: var(--mute); font-size: 11px; line-height: 1.6; }
  .foot-base p { margin: 0; }
  @media (max-width: 900px) {
    .foot-top { grid-template-columns: 1fr; gap: 32px; }
    .foot-cols { grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
    .foot-base { flex-direction: column; gap: 6px; }
  }
  @media (max-width: 900px) {
    .right { gap: 14px; }
    .nav { gap: 14px; font-size: 10px; }
    .home :global(.wm) { height: 24px; }
  }
  /* burger + dropdown menu, phones only */
  .burger { display: none; width: 40px; height: 40px; margin-right: -8px; padding: 0; border: 0; background: none; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
  .burger span { display: block; width: 20px; height: 2px; background: var(--ink); transition: transform 200ms ease, opacity 200ms ease; }
  .hdr.menu-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr.menu-open .burger span:nth-child(2) { opacity: 0; }
  .hdr.menu-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu { display: none; border-bottom: 1px solid var(--rule); background: var(--paper); }
  .menu .shell { display: flex; flex-direction: column; }
  .menu a { padding: 16px 0; border-top: 1px solid var(--rule); font-size: 13px; }
  .menu a:first-child { border-top: 0; }
  @media (max-width: 560px) {
    .nav { display: none; }
    .burger { display: flex; }
    .hdr.menu-open .menu { display: block; }
    .hdr.menu-open .top { border-bottom-color: transparent; }
  }
</style>
