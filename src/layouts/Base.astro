---
import '../styles/global.css';
import wordmarkRaw from '../../brand/wes-and-woodward-wordmark-black.svg?raw';
import D from '../../data/site/dashboard.json';

const { title = 'Wes & Woodward', description = 'Detroit hockey, by the numbers.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const wordmark = wordmarkRaw.replace('<svg ', '<svg class="wm" role="img" aria-label="Wes and Woodward" ').replace('fill="#000000"', 'fill="currentColor"');

// season banner
const S = D.standings, NG = D.nextGame;
const ordinal = (n) => { n = Number(n); const s = (10 <= n % 100 && n % 100 <= 20) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th'); return `${n}${s}`; };
const mdy = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const season = `${D.seasonLabel.slice(0, 4)}–${D.seasonLabel.slice(5)}`;
const vs = (g) => (g.home ? 'vs' : 'at');
const record = `${S.wins}–${S.losses}–${S.otLosses} · ${S.points} pts · ${ordinal(S.division.place)} in the ${S.division.name}`;
let banner = `${season} · ${record}`;
if (D.seasonState === 'offseason') {
  banner = `${season} final · ${record}`;
  if (NG) banner += ` · ${NG.season.slice(0, 4)}–${NG.season.slice(6)} opens ${mdy(NG.date)} ${vs(NG)} ${NG.opponent}`;
} else if (D.seasonState === 'preseason' && NG) {
  banner = `${season} opens ${mdy(NG.date)} ${vs(NG)} ${NG.opponent}`;
} else if (NG) {
  banner += ` · next ${vs(NG)} ${NG.opponent} ${mdy(NG.date)}`;
}
const nav = [['Team', `${base}#dashboard`], ['Players', `${base}#players`], ['Analysis', `${base}#analysis`], ['Prospects', `${base}#prospects`], ['About', `${base}about/`]];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <div class="banner mono lc">{banner}</div>
    <header class="hdr">
      <div class="shell">
        <div class="top">
          <a class="home" href={base} aria-label="Wes and Woodward, home" set:html={wordmark} />
          <div class="right">
            <nav class="nav mono" aria-label="Primary">
              {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            </nav>
            <a class="cta mono" href="#">Subscribe</a>
          </div>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="shell">
        <p>
          Wes &amp; Woodward is an independent publication and is not affiliated with the
          Detroit Red Wings or the NHL. Data: <a href="https://api-web.nhle.com">NHL API</a>,
          <a href="https://moneypuck.com">MoneyPuck</a>,
          <a href="https://hockeystatcards.com">HockeyStatCards</a>,
          <a href="https://www.naturalstattrick.com">Natural Stat Trick</a>,
          <a href="https://evolving-hockey.com">Evolving-Hockey</a> and
          <a href="https://www.eliteprospects.com">Elite Prospects</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .banner { background: var(--red); color: #fff; text-align: center; padding: 7px 12px; font-size: 12px; }
  .hdr { position: relative; z-index: 6; background: var(--paper); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 64px; border-bottom: 1px solid var(--rule); }
  .home { color: var(--ink); display: block; }
  .home :global(.wm) { height: 30px; width: auto; }
  .right { display: flex; align-items: center; gap: 28px; }
  .nav { display: flex; gap: 24px; }
  .cta { background: var(--ink); color: #fff; padding: 9px 14px; border-radius: 3px; font-size: 11px; }
  .cta:hover { background: var(--red); color: #fff; }
  footer { padding: 36px 0 60px; color: var(--mute); font-size: 12px; line-height: 1.6; }
  footer a { color: var(--mute); text-decoration: underline; }
  footer a:hover { color: var(--red); }
  @media (max-width: 900px) {
    .right { gap: 14px; }
    .nav { gap: 14px; font-size: 10px; }
    .home :global(.wm) { height: 24px; }
  }
  @media (max-width: 560px) {
    .nav { display: none; }
  }
</style>
